{
  "name": "svetinje-content-validation",
  "version": "0.1.0",
  "private": true,
  "description": "Schema and cross-reference validation for Svetinje.me editorial content.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run validate:content && pnpm test"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
