{
  "name": "@svetinje/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:validators": "node scripts/generate-canonical-validators.mjs",
    "test": "pnpm run generate:validators && node --test tests/*.test.mjs",
    "typecheck": "pnpm run generate:validators && tsc --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "verify:worker-bundle": "node scripts/verify-worker-bundle.mjs dist",
    "build": "pnpm run generate:validators && pnpm run build:client && wrangler deploy --dry-run --outdir dist && pnpm run verify:worker-bundle"
  },
  "dependencies": {
    "jose": "6.1.2",
    "yaml": "2.9.0",
    "maplibre-gl": "5.15.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "wrangler": "4.118.0",
    "esbuild": "0.28.1"
  }
}
