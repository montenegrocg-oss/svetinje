---
import EmptyCatalogueState from "./EmptyCatalogueState.astro";
import FilterChips from "./FilterChips.astro";
import HomepagePagination from "./HomepagePagination.astro";
import InterfaceIcon from "./InterfaceIcon.astro";
import PlaceCard from "./PlaceCard.astro";
import { pageCountForHomepagePreview } from "../lib/explorer-preview";
import type { VisiblePlace } from "../lib/content/publication";
import type { Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";

interface Props {
  places?: VisiblePlace[];
  totalPlaces?: number;
  locale?: Locale;
}

const { places = [], totalPlaces = places.length, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].homepage.explorer;
const visiblePlaceCount = Math.min(places.length, totalPlaces);
const totalPages = pageCountForHomepagePreview(totalPlaces);
const formatCopy = (template: string, values: Record<string, string | number>) => Object.entries(values)
  .reduce((value, [key, replacement]) => value.replaceAll(`{${key}}`, String(replacement)), template);
const initialPageStatus = totalPages > 0 ? formatCopy(copy.status.page, { current: 1, total: totalPages }) : "";
const initialStatus = visiblePlaceCount === 1 && totalPlaces === 1
  ? formatCopy(copy.status.one, { page: initialPageStatus })
  : visiblePlaceCount === 0
    ? copy.status.none
    : formatCopy(copy.status.many, { shown: visiblePlaceCount, matched: totalPlaces, page: initialPageStatus });
---

<aside class="explorer-sidebar" id="pretraga" aria-label={copy.aria} data-testid="explorer-sidebar">
  <form class="explorer-search" data-catalogue-search>
    <label class="sr-only" for="holy-place-search">{copy.searchLabel}</label>
    <span class="explorer-search__icon"><InterfaceIcon name="search" size={20} /></span>
    <input
      id="holy-place-search"
      name="q"
      type="search"
      placeholder={copy.searchPlaceholder}
      autocomplete="off"
      aria-describedby="catalogue-status"
    />
  </form>

  <div class="explorer-sidebar__desktop-category-filters" data-desktop-category-filters>
    <FilterChips group="catalogue" includeRoutes={false} locale={locale} />
  </div>
  <div class="explorer-area-filter" data-explorer-area-filter hidden>
    <span>{copy.areaPrefix}: <strong data-explorer-area-label></strong></span>
    <button type="button" data-clear-area-filter aria-label={copy.clearArea}>×</button>
  </div>
  <HomepagePagination totalPages={totalPages} position="top" locale={locale} />
  {places.length === 0 ? (
    <EmptyCatalogueState statusId="catalogue-status" locale={locale} />
  ) : (
    <div class="explorer-results">
      <p id="catalogue-status" class="sr-only" role="status" aria-live="polite">
        {initialStatus}
      </p>
      <div class="explorer-results__cards" data-explorer-primary-results>
        {places.map((place) => (
          <PlaceCard place={place} variant="sidebar" initialExplorerPlacement="primary" locale={locale} />
        ))}
      </div>
      <section class="explorer-no-results" data-explorer-no-results hidden role="status" aria-live="polite" aria-atomic="true">
        <p class="eyebrow">{copy.noResultsEyebrow}</p>
        <h2 data-no-results-title></h2>
        <p data-no-results-body></p>
      </section>
    </div>
  )}
  <HomepagePagination totalPages={totalPages} position="bottom" locale={locale} />
</aside>

<style>
  .explorer-sidebar__desktop-category-filters {
    display: contents;
  }

  @media (max-width: 47.99rem) {
    .explorer-sidebar__desktop-category-filters {
      display: none;
    }
  }
</style>
