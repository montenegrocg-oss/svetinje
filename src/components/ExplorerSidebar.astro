---
import EmptyCatalogueState from "./EmptyCatalogueState.astro";
import FilterChips from "./FilterChips.astro";
import InterfaceIcon from "./InterfaceIcon.astro";
import PlaceCard from "./PlaceCard.astro";
import type { VisiblePlace } from "../lib/content/publication";

interface Props {
  places?: VisiblePlace[];
}

const { places = [] } = Astro.props;
---

<aside class="explorer-sidebar" id="pretraga" aria-label="Претрага и филтри каталога" data-testid="explorer-sidebar">
  <form class="explorer-search" data-catalogue-search>
    <label class="sr-only" for="holy-place-search">Претражите светиње</label>
    <span class="explorer-search__icon"><InterfaceIcon name="search" size={20} /></span>
    <input
      id="holy-place-search"
      name="q"
      type="search"
      placeholder="Претражите светиње…"
      autocomplete="off"
      aria-describedby="catalogue-status"
    />
    <button class="icon-button" type="button" disabled aria-label="Подешавања филтера — ускоро" title="Подешавања филтера су у припреми">
      <InterfaceIcon name="filter" size={20} />
    </button>
  </form>

  <FilterChips group="catalogue" />
  {places.length === 0 ? (
    <EmptyCatalogueState statusId="catalogue-status" />
  ) : (
    <div class="explorer-results">
      <p id="catalogue-status" class="sr-only" role="status" aria-live="polite">
        Приказан је један запис у радном приказу.
      </p>
      {places.map((place) => <PlaceCard place={place} variant="sidebar" />)}
      <section class="explorer-no-results" data-explorer-no-results hidden role="status" aria-live="polite" aria-atomic="true">
        <p class="eyebrow">Претрага каталога</p>
        <h2 data-no-results-title></h2>
        <p data-no-results-body></p>
      </section>
    </div>
  )}
</aside>
