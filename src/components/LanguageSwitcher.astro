---
import { localeConfig, type Locale } from "../i18n/config";

interface Props {
  currentLocale?: Locale;
  destinations?: Partial<Record<Locale, string>>;
}

const { currentLocale = "sr", destinations = { sr: "/" } } = Astro.props;
const locales = Object.entries(localeConfig) as [Locale, (typeof localeConfig)[Locale]][];
---

<nav class="language-switcher" aria-label={currentLocale === "ru" ? "Выбор языка" : currentLocale === "en" ? "Language selector" : "Избор језика"}>
  <ul>
    {locales.map(([locale, config]) => (
      <li>
        {config.available && destinations[locale] ? (
          <a class:list={[locale === currentLocale && "language-current"]} href={destinations[locale]} lang={config.htmlLang} aria-current={locale === currentLocale ? "page" : undefined}>
            {config.label}
          </a>
        ) : (
          <span
            class="language-unavailable"
            lang={config.htmlLang}
            aria-disabled="true"
            title={currentLocale === "ru" ? "Перевод пока недоступен" : currentLocale === "en" ? "Translation is not available" : "Превод још није доступан"}
          >
            <span>{config.label}</span>
            <small>{currentLocale === "ru" ? "скоро" : currentLocale === "en" ? "soon" : "ускоро"}</small>
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>
