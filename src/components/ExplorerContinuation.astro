---
import PlaceCard from "./PlaceCard.astro";
import type { VisiblePlace } from "../lib/content/publication";

interface Props {
  places?: VisiblePlace[];
}

const { places = [] } = Astro.props;
const formatSlot = (slot: number) => String(slot).padStart(2, "0");
const slots = places.map((place, index) => ({
  place,
  slot: index + 5,
}));
---

<section
  class="explorer-continuation map-explorer__continuation"
  aria-label="Будући записи светиња"
  data-testid="explorer-continuation"
  data-explorer-continuation-results
  data-empty={places.length === 0 ? "true" : "false"}
>
  {slots.map(({ place, slot }) => (
    <PlaceCard
      place={place}
      variant="continuation"
      continuationSlot={formatSlot(slot)}
      initialExplorerPlacement="continuation"
    />
  ))}
</section>
