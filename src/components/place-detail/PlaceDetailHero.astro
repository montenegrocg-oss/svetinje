---
import InterfaceIcon from "../InterfaceIcon.astro";
import type { VisiblePlace } from "../../lib/content/publication";
import { categoryForPlaceType } from "../../lib/place-filters";
import { routeFor, type Locale } from "../../i18n/config";
import { publicCopy } from "../../i18n/public-copy";

interface Props {
  place: VisiblePlace;
  locale?: Locale;
}

const { place, locale = "sr" } = Astro.props;
const copy = publicCopy[locale];
const detailCopy = copy.pages.placeDetail;
const category = categoryForPlaceType(place.placeType);
const breadcrumb = category === "monasteries"
  ? { href: routeFor(locale, "monasteries"), label: copy.nav.monasteries }
  : category === "churches"
    ? { href: routeFor(locale, "churches"), label: copy.nav.churches }
    : locale === "sr"
      ? { href: routeFor(locale, "holyPlaces"), label: copy.siteName }
      : { href: routeFor(locale, "map"), label: copy.nav.map };
const location = place.settlement ?? place.municipality;
const hasCoordinates = place.latitude !== undefined && place.longitude !== undefined;
const actionMessages = JSON.stringify(detailCopy.actionMessages).replaceAll("<", "\\u003c");
---

<header class="place-profile-hero" data-place-id={place.id} data-place-detail-actions>
  {place.previewImageSrc ? (
    <img
      class="place-profile-hero__image"
      src={place.previewImageSrc}
      alt={place.previewImageAlt ?? place.name}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  ) : (
    <div class="place-profile-hero__fallback" aria-hidden="true"><span></span></div>
  )}
  <div class="place-profile-hero__overlay" aria-hidden="true"></div>

  <div class="shell place-profile-hero__content">
    <nav class="place-profile-breadcrumbs" aria-label={detailCopy.breadcrumbs}>
      <a href={routeFor(locale, "home")}>{detailCopy.home}</a><span aria-hidden="true">›</span>
      <a href={breadcrumb.href}>{breadcrumb.label}</a><span aria-hidden="true">›</span>
      <span aria-current="page">{place.name}</span>
    </nav>

    <div class="place-profile-hero__copy">
      <h1>{place.name}</h1>
      {place.summary && <p>{place.summary}</p>}
      <ul class="place-profile-chips" aria-label={detailCopy.facts}>
        {location && <li><InterfaceIcon name="place" size={16} />{location}</li>}
        <li><InterfaceIcon name={category === "monasteries" ? "monastery" : category === "churches" ? "church" : "place"} size={16} />{place.typeLabel}</li>
      </ul>
    </div>

    <div class="place-profile-actions" aria-label={detailCopy.actions}>
      <button type="button" class="place-profile-action place-profile-action--primary" data-place-detail-action="plan">
        <InterfaceIcon name="info" size={18} /><span>{detailCopy.plan}</span>
      </button>
      <button type="button" class="place-profile-action" data-place-detail-action="route">
        <InterfaceIcon name="route" size={18} /><span>{detailCopy.route}</span>
      </button>
      <button
        type="button"
        class="place-profile-action"
        data-place-detail-action="save"
        data-favorite-toggle
        data-favorite-id={place.id}
        aria-label={detailCopy.addFavorite}
        aria-pressed="false"
      >
        <InterfaceIcon name="heart" size={18} /><span data-favorite-label>{detailCopy.addFavorite}</span>
      </button>
    </div>

    <div class="place-profile-action-status" role="status" aria-live="polite" hidden>
      <span data-place-detail-action-message></span>
      {hasCoordinates && <a href={`${routeFor(locale, "home")}#mapa`} data-place-detail-map-link hidden>{detailCopy.openMap}</a>}
    </div>
    <script type="application/json" data-place-action-copy set:html={actionMessages} is:inline />
  </div>
</header>

<script>
  import { getFavoriteIds, subscribeFavorites, toggleFavorite } from "../../lib/favorites";

  type FavoritesDetailWindow = Window & { __svetinjeFavoritesDetailCleanup?: () => void };

  const initialisePlaceActions = () => {
    document.querySelectorAll<HTMLElement>("[data-place-detail-actions]").forEach((root) => {
      if (root.dataset.actionsInitialised === "true") return;
      root.dataset.actionsInitialised = "true";
      const status = root.querySelector<HTMLElement>(".place-profile-action-status");
      const message = root.querySelector<HTMLElement>("[data-place-detail-action-message]");
      const mapLink = root.querySelector<HTMLElement>("[data-place-detail-map-link]");
      const copyElement = root.querySelector<HTMLScriptElement>("[data-place-action-copy]");
      const messages = JSON.parse(copyElement?.textContent ?? "{}") as Record<string, string>;

      root.querySelectorAll<HTMLButtonElement>("[data-place-detail-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const action = button.dataset.placeDetailAction ?? "";
          if (action === "save") return;
          if (!status || !message || !messages[action]) return;
          message.textContent = messages[action];
          if (mapLink) mapLink.hidden = action !== "route";
          status.hidden = false;
        });
      });
    });
  };

  const initialiseFavoriteToggle = () => {
    const root = document.querySelector<HTMLElement>("[data-place-detail-actions]");
    if (!root || root.dataset.favoriteInitialised === "true") return;
    root.dataset.favoriteInitialised = "true";
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-favorite-toggle]")];
    const placeId = root.dataset.placeId ?? "";
    const copyElement = root.querySelector<HTMLScriptElement>("[data-place-action-copy]");
    const messages = JSON.parse(copyElement?.textContent ?? "{}") as Record<string, string>;
    const addLabel = buttons[0]?.getAttribute("aria-label") ?? "";
    const removeLabel = messages.removeFavorite ?? addLabel;

    const render = (ids: string[]) => {
      const active = ids.includes(placeId);
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(active));
        button.setAttribute("aria-label", active ? removeLabel : addLabel);
        const label = button.querySelector<HTMLElement>("[data-favorite-label]");
        if (label) label.textContent = active ? removeLabel : addLabel;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => render(toggleFavorite(button.dataset.favoriteId ?? placeId)));
    });
    render(getFavoriteIds());

    const favoritesWindow = window as FavoritesDetailWindow;
    favoritesWindow.__svetinjeFavoritesDetailCleanup?.();
    favoritesWindow.__svetinjeFavoritesDetailCleanup = subscribeFavorites(render);
  };

  initialisePlaceActions();
  initialiseFavoriteToggle();
  document.addEventListener("astro:page-load", () => {
    initialisePlaceActions();
    initialiseFavoriteToggle();
  });
</script>

<style>
  .place-profile-action[data-favorite-toggle][aria-pressed="true"] {
    border-color: #e0bd75;
    color: var(--navy-950);
    background: #f4cf83;
  }

  .place-profile-action[data-favorite-toggle][aria-pressed="true"] :global(.interface-icon) {
    fill: currentColor;
  }
</style>
