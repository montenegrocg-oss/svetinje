---
import InterfaceIcon from "../InterfaceIcon.astro";
import type { VisiblePlace } from "../../lib/content/publication";
import PlaceMiniMap from "./PlaceMiniMap.astro";
import type { Locale } from "../../i18n/config";
import { publicCopy } from "../../i18n/public-copy";

interface Props {
  place: VisiblePlace;
  locale?: Locale;
}

const { place, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].pages.placeDetail.practical;
const location = [place.settlement, place.municipality].filter(Boolean).join(" · ");
const hasCoordinates = place.latitude !== undefined && place.longitude !== undefined;
const coordinateText = hasCoordinates ? `${place.latitude}, ${place.longitude}` : undefined;
const typeIcon = place.placeType === "monastery"
  ? "monastery" as const
  : ["church", "chapel", "cathedral"].includes(place.placeType)
    ? "church" as const
    : "place" as const;
const practicalRows = [
  { label: copy.location, value: location, icon: "place" as const },
  { label: copy.address, value: place.address, icon: "info" as const },
  { label: copy.type, value: place.typeLabel, icon: typeIcon },
  { label: copy.jurisdiction, value: place.ecclesiasticalJurisdiction, icon: "church" as const },
].filter((row) => Boolean(row.value));
const patronalFeasts = place.patronalFeasts.filter((feast) => feast.trim());
const feastLabel = patronalFeasts.length === 1 ? copy.feast : copy.feasts;
const coordinateQualification = place.placeType === "cathedral"
  ? copy.cathedralNote
  : copy.placeNote;
---

<aside class="place-practical-panel" aria-labelledby="place-practical-title" data-coordinate-copy-root data-copy-success={copy.copied} data-copy-failure={copy.copyFailed}>
  <h2 id="place-practical-title">{copy.title}</h2>
  <dl class="place-practical-list">
    {practicalRows.map((row) => (
      <div>
        <dt><InterfaceIcon name={row.icon} size={17} />{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))}
    {patronalFeasts.length > 0 && (
      <div>
        <dt><InterfaceIcon name="church" size={17} />{feastLabel}</dt>
        <dd><ul class="place-practical-feasts">{patronalFeasts.map((feast) => <li>{feast}</li>)}</ul></dd>
      </div>
    )}
    {coordinateText && (
      <div class="place-practical-list__coordinates">
        <dt><InterfaceIcon name="target" size={17} />{copy.coordinates}</dt>
        <dd>
          <span>{coordinateText}</span>
          <button type="button" data-copy-coordinates={coordinateText} aria-label={copy.copy}><span aria-hidden="true">⧉</span></button>
        </dd>
      </div>
    )}
  </dl>

  {coordinateText && <p class="place-practical-panel__coordinate-note">{coordinateQualification}</p>}
  <p class="place-practical-panel__copy-status" role="status" aria-live="polite" data-coordinate-copy-status></p>

  {hasCoordinates && (
    <PlaceMiniMap latitude={place.latitude!} longitude={place.longitude!} name={place.name} placeType={place.placeType} locale={locale} />
  )}
</aside>

<script>
  const initialiseCoordinateCopy = () => {
    document.querySelectorAll<HTMLElement>("[data-coordinate-copy-root]").forEach((root) => {
      if (root.dataset.copyInitialised === "true") return;
      root.dataset.copyInitialised = "true";
      const button = root.querySelector<HTMLButtonElement>("[data-copy-coordinates]");
      const status = root.querySelector<HTMLElement>("[data-coordinate-copy-status]");
      button?.addEventListener("click", async () => {
        try {
          if (!navigator.clipboard) throw new Error("Clipboard unavailable");
          await navigator.clipboard.writeText(button.dataset.copyCoordinates ?? "");
          if (status) status.textContent = root.dataset.copySuccess ?? "";
        } catch {
          if (status) status.textContent = root.dataset.copyFailure ?? "";
        }
      });
    });
  };

  initialiseCoordinateCopy();
  document.addEventListener("astro:page-load", initialiseCoordinateCopy);
</script>
