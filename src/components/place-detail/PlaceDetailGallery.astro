---
import type { VisiblePlace } from "../../lib/content/publication";
import type { Locale } from "../../i18n/config";
import { publicCopy } from "../../i18n/public-copy";

interface Props { place: VisiblePlace; locale?: Locale; }
const { place, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].pages.placeDetail.gallery;
const [primaryImage, ...secondaryImages] = place.galleryImages;
const galleryId = `place-gallery-${place.id}`;
const videoTitle = `${copy.videoTitle} — ${place.name}`;
---

{(primaryImage || place.youtubeVideoId) && <div class="place-detail-media">
  {primaryImage && <section class="place-detail-gallery" aria-labelledby="place-gallery-title" data-testid="place-detail-gallery" data-place-gallery={galleryId}>
    <div class="place-section-heading"><h2 id="place-gallery-title">{copy.title}</h2></div>
    <div class="place-detail-gallery__grid" data-gallery-count={place.galleryImages.length}>
      <button class="place-detail-gallery__main place-detail-gallery__button" type="button" data-gallery-open data-gallery-index="0" aria-label={`${copy.enlarge}: ${primaryImage.alt}`}>
        <img src={primaryImage.src} alt={primaryImage.alt} width={primaryImage.width} height={primaryImage.height} loading="lazy" decoding="async" />
      </button>
      {secondaryImages.map((image, index) => (
        <button class="place-detail-gallery__image place-detail-gallery__button" type="button" data-gallery-open data-gallery-index={String(index + 1)} aria-label={`${copy.enlarge}: ${image.alt}`}>
          <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>

    <dialog class="place-gallery-lightbox" data-gallery-dialog aria-label={`${copy.aria} — ${place.name}`}>
      <div class="place-gallery-lightbox__surface">
        <button class="place-gallery-lightbox__close" type="button" data-gallery-close aria-label={copy.close}>×</button>
        <button class="place-gallery-lightbox__nav place-gallery-lightbox__nav--previous" type="button" data-gallery-previous aria-label={copy.previous}>‹</button>
        <figure><img data-gallery-image src={primaryImage.src} alt={primaryImage.alt} /><figcaption data-gallery-counter>1 / {place.galleryImages.length}</figcaption></figure>
        <button class="place-gallery-lightbox__nav place-gallery-lightbox__nav--next" type="button" data-gallery-next aria-label={copy.next}>›</button>
      </div>
    </dialog>
  </section>}

  {place.youtubeVideoId && <section class="place-detail-video" aria-labelledby={`${galleryId}-video-title`} data-testid="place-detail-video">
      <h2 id={`${galleryId}-video-title`}>{copy.video}</h2>
      <div class="place-detail-video__frame" data-youtube-player data-youtube-video-id={place.youtubeVideoId} data-youtube-title={videoTitle}>
        <p>{copy.videoPrompt}</p>
        <button type="button" data-youtube-load aria-label={`${copy.playVideo}: ${place.name}`}>{copy.playVideo}</button>
      </div>
    </section>}
</div>}

<script>
  const initialisePlaceGalleries = () => {
    document.querySelectorAll<HTMLElement>("[data-place-gallery]").forEach((root) => {
      if (root.dataset.galleryInitialised === "true") return;
      root.dataset.galleryInitialised = "true";
      const dialog = root.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
      const lightboxImage = dialog?.querySelector<HTMLImageElement>("[data-gallery-image]");
      const counter = dialog?.querySelector<HTMLElement>("[data-gallery-counter]");
      const openers = [...root.querySelectorAll<HTMLButtonElement>("[data-gallery-open]")];
      const images = openers.map((button) => button.querySelector<HTMLImageElement>("img")).filter((image): image is HTMLImageElement => Boolean(image));
      if (!dialog || !lightboxImage || images.length === 0) return;
      let index = 0;
      let trigger: HTMLButtonElement | undefined;
      const navigation = dialog.querySelectorAll<HTMLButtonElement>("[data-gallery-previous], [data-gallery-next]");
      navigation.forEach((button) => { button.hidden = images.length < 2; });
      const show = (nextIndex: number) => {
        index = (nextIndex + images.length) % images.length;
        lightboxImage.src = images[index]!.currentSrc || images[index]!.src;
        lightboxImage.alt = images[index]!.alt;
        if (counter) counter.textContent = `${index + 1} / ${images.length}`;
      };
      openers.forEach((button, openerIndex) => button.addEventListener("click", () => {
        trigger = button;
        show(openerIndex);
        dialog.showModal();
        document.documentElement.classList.add("has-open-lightbox");
        dialog.querySelector<HTMLButtonElement>("[data-gallery-close]")?.focus();
      }));
      const close = () => dialog.close();
      dialog.querySelector("[data-gallery-close]")?.addEventListener("click", close);
      dialog.querySelector("[data-gallery-previous]")?.addEventListener("click", () => show(index - 1));
      dialog.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(index + 1));
      dialog.addEventListener("click", (event) => { if (event.target === dialog) close(); });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") { event.preventDefault(); show(index - 1); }
        if (event.key === "ArrowRight") { event.preventDefault(); show(index + 1); }
      });
      dialog.addEventListener("close", () => { document.documentElement.classList.remove("has-open-lightbox"); trigger?.focus(); });
    });
  };

  const initialiseYoutubePlayers = () => {
    document.querySelectorAll<HTMLElement>("[data-youtube-player]").forEach((root) => {
      if (root.dataset.youtubeInitialised === "true") return;
      root.dataset.youtubeInitialised = "true";
      const button = root.querySelector<HTMLButtonElement>("[data-youtube-load]");
      const videoId = root.dataset.youtubeVideoId ?? "";
      const title = root.dataset.youtubeTitle ?? "Video";
      if (!button || !/^[A-Za-z0-9_-]{11}$/.test(videoId)) return;
      button.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
        iframe.title = title;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        root.replaceChildren(iframe);
      }, { once: true });
    });
  };

  initialisePlaceGalleries();
  initialiseYoutubePlayers();
  document.addEventListener("astro:page-load", () => {
    initialisePlaceGalleries();
    initialiseYoutubePlayers();
  });
</script>
