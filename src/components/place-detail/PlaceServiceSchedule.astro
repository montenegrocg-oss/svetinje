---
import type { Locale } from "../../i18n/config.ts";
import { publicCopy } from "../../i18n/public-copy.ts";

interface Props {
  schedule: string | undefined;
  locale: Locale;
}

const { schedule, locale } = Astro.props;
const normalizedSchedule = schedule?.trim();
const copy = publicCopy[locale].pages.placeDetail.serviceSchedule;
---

{normalizedSchedule && (
  <section class="place-service-schedule" aria-labelledby="place-service-schedule-title" data-testid="place-service-schedule">
    <h2 id="place-service-schedule-title">{copy.title}</h2>
    <p>{normalizedSchedule}</p>
  </section>
)}
