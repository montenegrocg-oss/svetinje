---
import type { NarrativeSection } from "../../lib/content/publication";

interface Props {
  sections: NarrativeSection[];
}

const { sections } = Astro.props;
---

{sections.map((section) => (
  <section class="place-narrative-segment" data-narrative-source-section={section.id}>
    {section.paragraphs.map((paragraph) => (
      <p>{paragraph.text}</p>
    ))}
  </section>
))}
