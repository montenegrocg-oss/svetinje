---
import type { VisiblePlace } from "../../lib/content/publication";
import { localeConfig, placeDetailRoot, routeFor, type Locale } from "../../i18n/config";
import { publicCopy } from "../../i18n/public-copy";
import type { RelatedPlace } from "../../lib/related-places";

interface Props {
  currentPlace: VisiblePlace;
  relatedPlaces: RelatedPlace[];
  locale?: Locale;
}

const { currentPlace, relatedPlaces, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].pages.placeDetail.related;
const placeholders = Array.from({ length: Math.max(0, 4 - relatedPlaces.length) });
const locationFor = (place: VisiblePlace) => [place.settlement, place.municipality].filter(Boolean).join(" · ");
const distanceFor = (distance: number) => copy.distance.replace("{distance}", new Intl.NumberFormat(localeConfig[locale].htmlLang, { maximumFractionDigits: 1 }).format(distance));
const allPlacesHref = locale === "sr" ? routeFor(locale, "holyPlaces") : routeFor(locale, "map");
---

<section class="place-related" aria-labelledby="place-related-title" data-testid="place-related-shelf" data-current-place={currentPlace.id}>
  <div class="place-related__heading">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2 id="place-related-title">{copy.title}</h2></div>
    <a href={allPlacesHref}>{copy.showAll}</a>
  </div>
  <div class="place-related__shelf">
    {relatedPlaces.map(({ place, distanceKm }) => (
      <a class="place-related-card" href={`${placeDetailRoot[locale]}${place.slug}/`} data-related-place={place.id}>
        {place.previewImageSrc ? (
          <img src={place.previewImageSrc} alt={place.previewImageAlt ?? place.name} loading="lazy" decoding="async" />
        ) : (
          <span class="place-related-card__media" aria-hidden="true"></span>
        )}
        <span class="place-related-card__copy">
          <strong>{place.name}</strong>
          {locationFor(place) && <small>{locationFor(place)}</small>}
          {distanceKm !== undefined && <small>{distanceFor(distanceKm)}</small>}
        </span>
      </a>
    ))}
    {placeholders.map(() => (
      <div class="place-related-card place-related-card--placeholder" data-related-placeholder>
        <span class="place-related-card__media" aria-hidden="true"></span>
        <span class="place-related-card__copy"><strong>{copy.placeholderTitle}</strong><small>{copy.placeholderBody}</small></span>
      </div>
    ))}
  </div>
</section>
