---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  locale?: import("../i18n/config").Locale;
  localeLinks?: Partial<Record<import("../i18n/config").Locale, string>>;
}

import { localeConfig, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
const { title, description, canonicalPath, noindex = false, locale = "sr", localeLinks = { [locale]: canonicalPath } } = Astro.props;
const siteName = publicCopy[locale].siteName;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : canonicalPath;
const alternateLinks = (Object.entries(localeLinks) as Array<[Locale, string]>).map(([alternateLocale, path]) => ({
  locale: alternateLocale,
  href: Astro.site ? new URL(path, Astro.site).toString() : path,
}));
const xDefault = alternateLinks.find((link) => link.locale === "sr")?.href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,nofollow,noarchive" : "index, follow"} />
<link rel="canonical" href={canonical} />
{alternateLinks.map((link) => <link rel="alternate" hreflang={localeConfig[link.locale].htmlLang} href={link.href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<link rel="icon" type="image/png" href="/favicon.png" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === "sr" ? "sr_ME" : locale === "ru" ? "ru_RU" : "en_US"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
