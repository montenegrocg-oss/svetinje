---
interface Props {
  totalPages: number;
  position: "top" | "bottom";
}

const { totalPages, position } = Astro.props;
const positionLabel = position === "top" ? "горња" : "доња";
---

<nav
  class:list={["explorer-pagination", "homepage-pagination", `homepage-pagination--${position}`]}
  data-homepage-pagination
  data-homepage-pagination-position={position}
  aria-label={`Странице прегледа светиња — ${positionLabel} навигација`}
  hidden={totalPages === 0}
>
  <button type="button" data-homepage-pagination-prev aria-label="Претходна страница" disabled aria-disabled="true">←</button>
  <span class="homepage-pagination__status" data-homepage-pagination-status aria-live="polite">1 / {totalPages || 1}</span>
  <button
    type="button"
    data-homepage-pagination-next
    aria-label="Сљедећа страница"
    disabled={totalPages <= 1}
    aria-disabled={totalPages <= 1 ? "true" : "false"}
  >→</button>
</nav>
