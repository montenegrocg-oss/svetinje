---
import { formatNewsDate, type VisibleNewsItem } from "../../lib/content/news";
import { newsDateParts } from "../../lib/news-types";

interface Props {
  item: VisibleNewsItem;
  variant?: "homepage" | "archive";
}

const { item, variant = "homepage" } = Astro.props;
const date = newsDateParts(item.publishedAt, item.locale);
---

<article
  class:list={["news-feed-item", `news-feed-item--${variant}`]}
  data-news-item={item.id}
  data-news-type={item.type}
  data-news-month={date.archiveKey}
  data-published-at={item.publishedAt}
>
  <a class="news-feed-item__link" href={item.href}>
    <time class="news-feed-item__date" datetime={item.publishedAt}>
      <span class="news-feed-item__day" aria-hidden="true">{date.day}</span>
      <span class="news-feed-item__month" aria-hidden="true">{date.monthYear}</span>
      <span class="news-feed-item__date-compact">{formatNewsDate(item.publishedAt)}</span>
    </time>
    <span class="news-feed-item__badge">{item.typeLabel}</span>
    <div class="news-feed-item__content">
      <h3>{item.title}</h3>
      <p>{item.summary}</p>
    </div>
    <span class="news-feed-item__arrow" aria-hidden="true">→</span>
  </a>
</article>
