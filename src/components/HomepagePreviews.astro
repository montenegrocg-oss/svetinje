---
import InterfaceIcon from "./InterfaceIcon.astro";
---

<section class="guide-previews" aria-label="Садржај у припреми">
  <div class="shell guide-previews__grid">
    <section class="routes-shelf" id="rute" aria-labelledby="routes-title">
      <header class="shelf-heading">
        <h2 id="routes-title">Популарне руте</h2>
        <span aria-disabled="true">Прикажи све</span>
      </header>
      <article class="route-placeholder">
        <div class="route-placeholder__visual" aria-hidden="true">
          <span></span><i></i><i></i><i></i>
        </div>
        <div>
          <p class="placeholder-label">У припреми</p>
          <h3>Поклоничке руте су у припреми.</h3>
          <p>Путање ће бити приказане тек након провјере свих укључених мјеста и практичних података.</p>
        </div>
        <InterfaceIcon name="route" size={22} />
      </article>
    </section>

    <section class="places-shelf" aria-labelledby="recommended-title">
      <header class="shelf-heading">
        <h2 id="recommended-title">Препоручене светиње</h2>
        <a href="/svetinje/">Прикажи све</a>
      </header>
      <div class="place-previews" role="list" aria-label="Будући провјерени записи">
        {Array.from({ length: 5 }).map((_, index) => (
          <article class="place-preview" role="listitem">
            <div class="place-preview__media" aria-hidden="true">
              <span></span><i></i><b>0{index + 1}</b>
            </div>
            <p>Провјерени запис у припреми</p>
            <small>Фотографија након провјере права</small>
          </article>
        ))}
      </div>
    </section>
  </div>
</section>
