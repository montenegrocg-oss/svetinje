---
import type { VisiblePlace } from "../lib/content/publication";
import type { VisibleRoute } from "../lib/content/routes";
import MapCanvas from "./MapCanvas.astro";
import MapControls from "./MapControls.astro";
import InterfaceIcon from "./InterfaceIcon.astro";
import { publicCopy } from "../i18n/public-copy";
import { createDedicatedMapSearchIndex } from "../lib/dedicated-map-visibility";

interface Props {
  places: VisiblePlace[];
  routes?: VisibleRoute[];
  locale?: import("../i18n/config").Locale;
}

const { places, routes = [], locale = "sr" } = Astro.props;
const copy = publicCopy[locale].pages.map;
const searchIndex = createDedicatedMapSearchIndex(places);
const searchPayload = JSON.stringify(searchIndex).replaceAll("<", "\\u003c");
const countCopyPayload = JSON.stringify({ shown: copy.shown }).replaceAll("<", "\\u003c");
const initialCount = copy.shown.replace("{count}", String(searchIndex.length));
const searchId = `dedicated-map-search-${locale}`;
const hasMapTilerKey = Boolean(import.meta.env.PUBLIC_MAPTILER_KEY?.trim());
---

<section class="dedicated-map" aria-label={copy.aria} data-dedicated-map>
  <div class="map-stage dedicated-map-page__stage">
    <MapCanvas places={places} routes={routes} layout="full" locale={locale} />
    <div class="dedicated-map-search" data-map-search-panel>
      <form data-dedicated-map-search>
        <label class="sr-only" for={searchId}>{copy.searchLabel}</label>
        <div class="dedicated-map-search__field">
          <InterfaceIcon name="search" size={19} />
          <input
            id={searchId}
            type="search"
            name="map-search"
            placeholder={copy.searchPlaceholder}
            autocomplete="off"
            data-map-search-input
            disabled={!hasMapTilerKey}
          />
        </div>
      </form>
      <p class="dedicated-map-search__status" role="status" aria-live="polite" data-map-visible-count>{initialCount}</p>
    </div>
    <MapControls variant="map-page" locale={locale} />
  </div>
  <script type="application/json" data-dedicated-map-search-index set:html={searchPayload} is:inline />
  <script type="application/json" data-dedicated-map-copy set:html={countCopyPayload} is:inline />
</section>

<script>
  import {
    DEDICATED_MAP_CATEGORIES,
    filterDedicatedMapPlaces,
    type DedicatedMapCategory,
    type DedicatedMapSearchEntry,
  } from "../lib/dedicated-map-visibility";

  document.querySelectorAll<HTMLElement>("[data-dedicated-map]").forEach((root) => {
    if (root.dataset.mapFiltersInitialised === "true") return;
    root.dataset.mapFiltersInitialised = "true";
    const filterButtons = [...root.querySelectorAll<HTMLButtonElement>("button[data-filter]")];
    const searchForm = root.querySelector<HTMLFormElement>("[data-dedicated-map-search]");
    const searchInput = searchForm?.querySelector<HTMLInputElement>("[data-map-search-input]");
    const status = root.querySelector<HTMLElement>("[data-map-visible-count]");
    const searchIndexElement = root.querySelector<HTMLScriptElement>("[data-dedicated-map-search-index]");
    const copyElement = root.querySelector<HTMLScriptElement>("[data-dedicated-map-copy]");
    const places = JSON.parse(searchIndexElement?.textContent ?? "[]") as DedicatedMapSearchEntry[];
    const runtimeCopy = JSON.parse(copyElement?.textContent ?? "{}") as { shown?: string };
    const categoryIds = new Set<string>(DEDICATED_MAP_CATEGORIES);
    let activeCategory: DedicatedMapCategory = "all";

    const applyMapState = () => {
      const visibleIds = filterDedicatedMapPlaces({
        places,
        category: activeCategory,
        query: searchInput?.value ?? "",
      });
      filterButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.filter === activeCategory));
      });
      if (status && runtimeCopy.shown) {
        status.textContent = runtimeCopy.shown.replace("{count}", String(visibleIds.length));
      }
      window.dispatchEvent(new CustomEvent("svetinje:place-visibility-change", { detail: { visibleIds } }));
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        if (!filter || !categoryIds.has(filter)) return;
        activeCategory = filter as DedicatedMapCategory;
        applyMapState();
      });
    });

    searchInput?.addEventListener("input", applyMapState);
    searchForm?.addEventListener("submit", (event) => event.preventDefault());
  });
</script>
