---
interface Props {
  searchPlaceholder: string;
  areas: ReadonlyArray<{ id: string; label: string }>;
  statusText?: string;
  locale?: import("../i18n/config").Locale;
}

import { routeFor, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
const { searchPlaceholder, areas, statusText, locale = "sr" } = Astro.props;
const copy = publicCopy[locale as Locale];
---

<div class="catalogue-toolbar" data-catalogue-toolbar>
  <label class="catalogue-toolbar__search">
    <span class="sr-only">{searchPlaceholder}</span>
    <input type="search" placeholder={searchPlaceholder} autocomplete="off" data-catalogue-search />
  </label>
  <label class="catalogue-toolbar__area">
    <span class="sr-only">{copy.chooseArea}</span>
    <select data-catalogue-area>
      <option value="">{copy.allAreas}</option>
      {areas.map((area) => <option value={area.id}>{area.label}</option>)}
    </select>
  </label>
  {statusText && (
    <p class="catalogue-toolbar__status" data-catalogue-result-status role="status" aria-live="polite">
      {statusText}
    </p>
  )}
  <div class="catalogue-toolbar__actions">
    <a href={routeFor(locale, "map")}>{copy.showMap} <span aria-hidden="true">→</span></a>
    <button type="button" data-catalogue-reset hidden disabled>{copy.clear}</button>
  </div>
</div>
