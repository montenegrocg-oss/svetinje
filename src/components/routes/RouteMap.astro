---
import type { VisibleRoute } from "../../lib/content/routes";
import { resolveMarkerAsset } from "../../lib/map-marker-assets";
interface Props { route: VisibleRoute }
const { route } = Astro.props;
const hasKey = Boolean(import.meta.env.PUBLIC_MAPTILER_KEY?.trim());
const startAsset = resolveMarkerAsset(route.startPlace.placeType)?.src;
const endAsset = resolveMarkerAsset(route.endPlace.placeType)?.src;
const mapData = JSON.stringify({ trackUrl: route.trackUrl, start: { latitude: route.startPlace.latitude, longitude: route.startPlace.longitude, asset: startAsset }, end: { latitude: route.endPlace.latitude, longitude: route.endPlace.longitude, asset: endAsset } }).replaceAll("<", "\\u003c");
---

<section class="route-map-section" aria-labelledby="route-map-title">
  <header class="route-map-section__header"><p class="section-eyebrow">Траса</p><h2 id="route-map-title">Интерактивна карта</h2></header>
  <a class="route-download" href={route.gpxUrl} download>Преузми GPX</a>
  <div class="route-map" data-route-map data-has-key={String(hasKey)}>
    <div class="route-map__fallback" data-route-map-fallback><span aria-hidden="true"></span><p>{hasKey ? "Учитавање карте…" : "Карта је тренутно недоступна. Траса је сачувана и може се преузети као GPX."}</p></div>
    <div class="route-map__canvas" data-route-map-canvas aria-label="Интерактивна карта пјешачке руте"></div>
    <script is:inline type="application/json" data-route-map-data set:html={mapData}></script>
  </div>
</section>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  const key = import.meta.env.PUBLIC_MAPTILER_KEY?.trim();
  document.querySelectorAll<HTMLElement>("[data-route-map]").forEach(async (root) => {
    if (!key || root.dataset.routeMapInitialised === "true") return;
    const canvas = root.querySelector<HTMLElement>("[data-route-map-canvas]");
    const fallback = root.querySelector<HTMLElement>("[data-route-map-fallback]");
    const dataNode = root.querySelector<HTMLScriptElement>("[data-route-map-data]");
    if (!canvas || !dataNode) return;
    root.dataset.routeMapInitialised = "true";
    const data = JSON.parse(dataNode.textContent ?? "{}") as { trackUrl: string; start: { latitude?: number; longitude?: number; asset?: string }; end: { latitude?: number; longitude?: number; asset?: string } };
    try {
      const response = await fetch(data.trackUrl, { credentials: "same-origin" });
      if (!response.ok) throw new Error("track unavailable");
      const track = await response.json() as GeoJSON.Feature<GeoJSON.LineString>;
      await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      if (canvas.clientWidth <= 0 || canvas.clientHeight <= 0) throw new Error("map container has no layout size");
      const map = new maplibregl.Map({
        container: canvas,
        style: `https://api.maptiler.com/maps/019fc7d8-717c-701d-9ca5-a53d9438d3ce/style.json?key=${encodeURIComponent(key)}`,
        attributionControl: false,
      });
      const transparentImage = { width: 1, height: 1, data: new Uint8Array([0, 0, 0, 0]) };
      map.on("styleimagemissing", (event) => {
        if (!map.hasImage(event.id)) map.addImage(event.id, transparentImage);
      });
      map.once("styledata", () => map.setTerrain(null));
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
      map.addControl(new maplibregl.AttributionControl({ compact: true }));
      const resizeObserver = new ResizeObserver(() => {
        if (canvas.clientWidth > 0 && canvas.clientHeight > 0) map.resize();
      });
      resizeObserver.observe(root);
      const removeMap = () => { resizeObserver.disconnect(); map.remove(); };
      window.addEventListener("pagehide", removeMap, { once: true });
      map.once("load", () => {
        map.addSource("route-track", { type: "geojson", data: track });
        map.addLayer({ id: "route-track-casing", type: "line", source: "route-track", paint: { "line-color": "#fff", "line-width": 7, "line-opacity": 0.82 } });
        map.addLayer({ id: "route-track", type: "line", source: "route-track", paint: { "line-color": "#b88a2d", "line-width": 4 } });
        const bounds = new maplibregl.LngLatBounds();
        track.geometry.coordinates.forEach((coordinate) => bounds.extend([coordinate[0]!, coordinate[1]!]));
        for (const point of [data.start, data.end]) {
          if (point.latitude === undefined || point.longitude === undefined) continue;
          const element = document.createElement("span");
          element.className = "route-map-marker";
          if (point.asset) { const image = document.createElement("img"); image.src = point.asset; image.alt = ""; element.append(image); }
          new maplibregl.Marker({ element, anchor: "bottom" }).setLngLat([point.longitude, point.latitude]).addTo(map);
        }
        fallback?.setAttribute("hidden", "");
        map.resize();
        map.fitBounds(bounds, { padding: 48, duration: matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 600 });
        requestAnimationFrame(() => map.resize());
      });
    } catch { fallback?.querySelector("p")?.replaceChildren("Карта није могла бити учитана. Покушајте поново или преузмите GPX."); }
  });
</script>
