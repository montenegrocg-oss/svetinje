---
import type { VisiblePlace } from "../lib/content/publication";

interface Props {
  place: VisiblePlace;
  variant?: "sidebar" | "catalogue";
}

const { place, variant = "catalogue" } = Astro.props;
const location = [place.municipality, place.settlement].filter(Boolean).join(" · ");
---

<article
  class:list={["editorial-place-card", `editorial-place-card--${variant}`]}
  data-place-card={place.id}
  data-place-search={place.searchText.toLocaleLowerCase("sr")}
  data-selected="false"
>
  <div class="editorial-place-card__topline">
    <p class="eyebrow">{place.typeLabel}</p>
    {place.preview && <span class="preview-badge">Радни приказ</span>}
  </div>
  <h2>{place.name}</h2>
  {location && <p class="editorial-place-card__location">{location}</p>}
  <p class="editorial-place-card__summary">{place.summary}</p>
  <a class="editorial-place-card__link" href={`/svetinje/${place.slug}/`}>
    Отвори страницу <span aria-hidden="true">→</span>
  </a>
</article>
