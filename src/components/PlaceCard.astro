---
import type { VisiblePlace } from "../lib/content/publication";
import { categoryForPlaceType } from "../lib/place-filters";
import { placeDetailRoot, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
import { placeTaxonomyCatalogueHref, placeTaxonomyLabel } from "../i18n/place-taxonomy";

interface Props {
  place: VisiblePlace;
  variant?: "sidebar" | "catalogue" | "featured";
  initialExplorerPlacement?: "primary" | "pool";
  locale?: Locale;
}

const { place, variant = "catalogue", initialExplorerPlacement, locale = "sr" } = Astro.props;
const category = categoryForPlaceType(place.placeType);
const detailHref = `${placeDetailRoot[locale]}${place.slug}/`;
const location = [place.municipalityId ? undefined : place.municipality, place.settlement].filter(Boolean).join(" · ");
const taxonomyItems = [
  place.eparchyId ? { kind: "eparchy" as const, id: place.eparchyId } : undefined,
  place.municipalityId ? { kind: "municipality" as const, id: place.municipalityId } : undefined,
].flatMap((item) => {
  if (!item) return [];
  const label = placeTaxonomyLabel(locale, item.kind, item.id);
  if (!label) return [];
  return [{ ...item, label, href: placeTaxonomyCatalogueHref(locale, category, item.kind, item.id) }];
});
---

<article
  class:list={["editorial-place-card", `editorial-place-card--${variant}`, taxonomyItems.length > 0 && "editorial-place-card--has-taxonomy"]}
  data-place-card={place.id}
  data-place-area={place.browseAreaId ?? ""}
  data-place-category={category ?? ""}
  data-place-search={place.catalogueSearchText}
  data-selected="false"
  data-initial-explorer-placement={initialExplorerPlacement}
>
  {place.previewImageSrc && variant !== "catalogue" && (
    <div class="editorial-place-card__media">
      <img
        class="editorial-place-card__image"
        src={place.previewImageSrc}
        alt={place.previewImageAlt ?? place.name}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {!place.previewImageSrc && variant === "sidebar" && (
    <div class="editorial-place-card__media editorial-place-card__media--fallback" aria-hidden="true">
      <span></span>
      <i></i>
    </div>
  )}
  <div class="editorial-place-card__topline">
    <p class="eyebrow">{place.typeLabel}</p>
  </div>
  <h2>
    {variant === "sidebar"
      ? <a class="editorial-place-card__title-link" href={detailHref}>{place.name}</a>
      : place.name}
  </h2>
  {location && <p class="editorial-place-card__location">{location}</p>}
  {taxonomyItems.length > 0 && (
    <ul class="editorial-place-card__taxonomy">
      {taxonomyItems.map((item) => (
        <li>
          {item.href ? <a href={item.href} title={item.label}>{item.label}</a> : <span>{item.label}</span>}
        </li>
      ))}
    </ul>
  )}
  {place.summary && <p class="editorial-place-card__summary">{place.summary}</p>}
  {variant !== "sidebar" && (
    <a class="editorial-place-card__link" href={detailHref}>
      {publicCopy[locale].openPage} <span aria-hidden="true">→</span>
    </a>
  )}
</article>
