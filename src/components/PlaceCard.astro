---
import type { VisiblePlace } from "../lib/content/publication";
import { categoryForPlaceType } from "../lib/place-filters";
import { placeDetailRoot, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";

interface Props {
  place: VisiblePlace;
  variant?: "sidebar" | "catalogue" | "featured";
  initialExplorerPlacement?: "primary" | "pool";
  locale?: Locale;
}

const { place, variant = "catalogue", initialExplorerPlacement, locale = "sr" } = Astro.props;
const category = categoryForPlaceType(place.placeType);
const location = [place.municipality, place.settlement].filter(Boolean).join(" · ");
---

<article
  class:list={["editorial-place-card", `editorial-place-card--${variant}`]}
  data-place-card={place.id}
  data-place-area={place.browseAreaId ?? ""}
  data-place-category={category ?? ""}
  data-place-search={place.catalogueSearchText}
  data-selected="false"
  data-initial-explorer-placement={initialExplorerPlacement}
>
  {place.previewImageSrc && variant !== "catalogue" && (
    <div class="editorial-place-card__media">
      <img
        class="editorial-place-card__image"
        src={place.previewImageSrc}
        alt={place.previewImageAlt ?? place.name}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  {!place.previewImageSrc && variant === "sidebar" && (
    <div class="editorial-place-card__media editorial-place-card__media--fallback" aria-hidden="true">
      <span></span>
      <i></i>
    </div>
  )}
  <div class="editorial-place-card__topline">
    <p class="eyebrow">{place.typeLabel}</p>
  </div>
  <h2>{place.name}</h2>
  {location && <p class="editorial-place-card__location">{location}</p>}
  {place.summary && <p class="editorial-place-card__summary">{place.summary}</p>}
  <a class="editorial-place-card__link" href={`${placeDetailRoot[locale]}${place.slug}/`}>
    {publicCopy[locale].openPage} <span aria-hidden="true">→</span>
  </a>
</article>
