---
interface Props {
  statusId: string;
  locale?: import("../i18n/config").Locale;
}

import { routeFor } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
const { statusId, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].homepage.explorer.empty;
const policyLink = locale === "sr" ? routeFor(locale, "sources") : routeFor(locale, "about");
---

<div class="catalogue-empty" id={statusId} role="status" aria-live="polite">
  <div class="catalogue-empty__message">
    <span class="empty-seal" aria-hidden="true">{copy.seal}</span>
    <div>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
    </div>
  </div>

  <div class="catalogue-skeletons" aria-hidden="true">
    {Array.from({ length: 3 }).map((_, index) => (
      <div class="catalogue-skeleton">
        <span class="catalogue-skeleton__media"></span>
        <span class="catalogue-skeleton__copy">
          <i></i><i></i><i></i>
        </span>
        <small>0{index + 1}</small>
      </div>
    ))}
  </div>

  <a class="panel-link" href={policyLink}>
    {copy.link}
    <span aria-hidden="true">→</span>
  </a>
</div>
