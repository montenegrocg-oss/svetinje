---
import ExplorerSidebar from "./ExplorerSidebar.astro";
import MapCanvas from "./MapCanvas.astro";
import MapControls from "./MapControls.astro";
import PlaceCard from "./PlaceCard.astro";
import PopularRoutes from "./PopularRoutes.astro";
import RecommendedPlaces from "./RecommendedPlaces.astro";
import { HOMEPAGE_PREVIEW_LIMIT } from "../lib/explorer-preview";
import type { VisiblePlace } from "../lib/content/publication";

interface Props {
  places: VisiblePlace[];
}

const { places } = Astro.props;
const initialPlaces = places.slice(0, HOMEPAGE_PREVIEW_LIMIT);
const inventoryPlaces = places.slice(HOMEPAGE_PREVIEW_LIMIT);
---

<section class="map-explorer" id="mapa" aria-labelledby="map-explorer-title" data-testid="map-explorer">
  <header class="map-explorer__heading">
    <p class="map-eyebrow">Дигитални водич</p>
    <h1 id="map-explorer-title">Православна Црна Гора</h1>
    <span class="title-rule" aria-hidden="true"></span>
    <p>Откријте манастире, храмове и света мјеста широм Црне Горе.</p>
  </header>

  <div class="map-stage">
    <MapCanvas places={places} />
    <MapControls />
  </div>

  <div class="map-explorer__content">
    <ExplorerSidebar places={initialPlaces} totalPlaces={places.length} />
    <div class="map-explorer__secondary">
      <RecommendedPlaces places={places} />
      <PopularRoutes />
    </div>
  </div>

  <div data-explorer-card-pool hidden>
    {inventoryPlaces.map((place) => (
      <PlaceCard place={place} variant="sidebar" initialExplorerPlacement="pool" />
    ))}
  </div>
</section>

<script>
  import {
    selectHomepagePreview,
  } from "../lib/explorer-preview";
  import { getPlaceArea } from "../lib/place-areas";

  document.querySelectorAll<HTMLButtonElement>("[data-notice-trigger]").forEach((button) => {
    button.addEventListener("click", () => {
      const targetId = button.dataset.noticeTrigger;
      if (!targetId) return;
      const notice = document.getElementById(targetId);
      if (!notice) return;
      notice.hidden = false;
      notice.focus({ preventScroll: true });
    });
  });

  const searchForm = document.querySelector<HTMLFormElement>("[data-catalogue-search]");
  const searchInput = searchForm?.querySelector<HTMLInputElement>("input[type='search']");
  const explorerRoot = document.querySelector<HTMLElement>("[data-testid='map-explorer']");
  const placeCards = [...(explorerRoot?.querySelectorAll<HTMLElement>("[data-place-card]") ?? [])];
  const primaryResults = explorerRoot?.querySelector<HTMLElement>("[data-explorer-primary-results]");
  const cardPool = explorerRoot?.querySelector<HTMLElement>("[data-explorer-card-pool]");
  const resultStatus = document.getElementById("catalogue-status");
  const noResults = explorerRoot?.querySelector<HTMLElement>("[data-explorer-no-results]");
  const noResultsTitle = noResults?.querySelector<HTMLElement>("[data-no-results-title]");
  const noResultsBody = noResults?.querySelector<HTMLElement>("[data-no-results-body]");
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-filter]")];
  const areaFilter = explorerRoot?.querySelector<HTMLElement>("[data-explorer-area-filter]");
  const areaFilterLabel = areaFilter?.querySelector<HTMLElement>("[data-explorer-area-label]");
  const clearAreaFilterButton = areaFilter?.querySelector<HTMLButtonElement>("[data-clear-area-filter]");
  const filterIds = new Set(["all", "monasteries", "churches", "holy-places", "routes"]);
  let activeFilter = "all";
  let activeAreaId = getPlaceArea(new URL(window.location.href).searchParams.get("area"))?.id ?? null;
  let matchedCards = [...placeCards];
  let selectedPlaceId: string | null = null;

  const noResultCopy: Record<string, { title: string; body: string }> = {
    monasteries: {
      title: "Нема манастира у овом приказу",
      body: "Тренутно нема манастира који одговарају изабраном филтеру и претрази.",
    },
    churches: {
      title: "Нема храмова у овом приказу",
      body: "Тренутно нема храмова доступних у радном приказу.",
    },
    "holy-places": {
      title: "Нема светих мјеста у овом приказу",
      body: "Тренутно нема светих мјеста доступних у радном приказу.",
    },
    routes: {
      title: "Поклоничке руте су у припреми",
      body: "Руте ће бити приказане након провјере свих укључених мјеста и практичних података.",
    },
    all: {
      title: "Нема резултата",
      body: "Покушајте са другим називом или изаберите другу категорију.",
    },
  };

  const setCardPlacement = (card: HTMLElement, placement: "primary" | "pool") => {
    card.classList.add("editorial-place-card--sidebar");
    card.hidden = placement === "pool";
  };

  const renderPreview = () => {
    if (!primaryResults || !cardPool) return 0;
    const selectedCard = selectedPlaceId
      ? matchedCards.find((card) => card.dataset.placeCard === selectedPlaceId) ?? null
      : null;
    const previewCards = selectHomepagePreview(matchedCards, selectedCard);

    placeCards.forEach((card) => {
      setCardPlacement(card, "pool");
      cardPool.append(card);
    });
    previewCards.forEach((card) => {
      setCardPlacement(card, "primary");
      primaryResults.append(card);
    });
    return previewCards.length;
  };

  const syncAreaFilter = () => {
    const area = getPlaceArea(activeAreaId);
    if (areaFilter) areaFilter.hidden = !area;
    if (areaFilterLabel) areaFilterLabel.textContent = area?.label ?? "";
  };

  const updateResultStatus = (shown: number, matched: number) => {
    if (!resultStatus) return;
    resultStatus.textContent = matched === 0
      ? "Нема записа за изабрани филтер."
      : shown === 1
        ? "Приказан је један резултат."
        : shown < matched
          ? `Приказана су ${shown} од ${matched} резултата.`
          : `Приказана су ${shown} резултата.`;
  };

  const applyExplorerState = (resetSelection = false) => {
    syncAreaFilter();
    if (placeCards.length === 0) {
      window.dispatchEvent(new CustomEvent("svetinje:place-visibility-change", { detail: { visibleIds: [] } }));
      return;
    }
    if (resetSelection) {
      selectedPlaceId = null;
      placeCards.forEach((card) => { card.dataset.selected = "false"; });
    }
    const query = searchInput?.value.trim().toLocaleLowerCase("sr") ?? "";
    matchedCards = placeCards.filter((card) => {
      const matchesArea = !activeAreaId || card.dataset.placeArea === activeAreaId;
      const matchesCategory = activeFilter === "all" || card.dataset.placeCategory === activeFilter;
      const matchesSearch = !query || (card.dataset.placeSearch ?? "").includes(query);
      const matches = matchesArea && matchesCategory && matchesSearch;
      if (!matches) card.dataset.selected = "false";
      return matches;
    });
    const visibleIds = matchedCards.map((card) => card.dataset.placeCard ?? "");
    const shown = renderPreview();

    filterButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.filter === activeFilter));
    });

    if (noResults) noResults.hidden = matchedCards.length !== 0;
    if (matchedCards.length === 0 && noResultsTitle && noResultsBody) {
      const fallbackCopy = noResultCopy.all;
      if (!fallbackCopy) return;
      const copy = (query ? noResultCopy.all : noResultCopy[activeFilter]) ?? fallbackCopy;
      noResultsTitle.textContent = copy.title;
      noResultsBody.textContent = copy.body;
    }

    updateResultStatus(shown, matchedCards.length);
    window.dispatchEvent(new CustomEvent("svetinje:filter-change", { detail: { filter: activeFilter } }));
    window.dispatchEvent(new CustomEvent("svetinje:place-visibility-change", { detail: { visibleIds } }));
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      if (!filter || !filterIds.has(filter)) return;
      activeFilter = filter;
      applyExplorerState(true);
    });
  });

  searchInput?.addEventListener("input", () => applyExplorerState(true));
  searchForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    applyExplorerState(true);
    resultStatus?.scrollIntoView({ block: "nearest" });
  });

  clearAreaFilterButton?.addEventListener("click", () => {
    activeAreaId = null;
    const url = new URL(window.location.href);
    url.searchParams.delete("area");
    window.history.replaceState(window.history.state, "", `${url.pathname}${url.search}${url.hash}`);
    applyExplorerState(true);
  });

  const handlePopState = () => {
    activeAreaId = getPlaceArea(new URL(window.location.href).searchParams.get("area"))?.id ?? null;
    applyExplorerState(true);
  };
  window.addEventListener("popstate", handlePopState);

  const handlePlaceSelection = ((event: CustomEvent<{ id: string }>) => {
    const selectedCard = matchedCards.find((card) => card.dataset.placeCard === event.detail.id);
    if (!selectedCard) return;
    selectedPlaceId = event.detail.id;
    placeCards.forEach((card) => {
      card.dataset.selected = String(card === selectedCard);
    });
    renderPreview();
    if (resultStatus) resultStatus.textContent = "Изабрани запис је истакнут на карти и у прегледу.";
  }) as EventListener;

  const handleClearedSelection = ((event: CustomEvent<{ id: string }>) => {
    if (selectedPlaceId !== event.detail.id) return;
    selectedPlaceId = null;
    const card = placeCards.find((candidate) => candidate.dataset.placeCard === event.detail.id);
    if (card) card.dataset.selected = "false";
    const shown = renderPreview();
    updateResultStatus(shown, matchedCards.length);
  }) as EventListener;

  window.addEventListener("svetinje:place-select", handlePlaceSelection);
  window.addEventListener("svetinje:place-selection-cleared", handleClearedSelection);
  applyExplorerState();

  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener("svetinje:place-select", handlePlaceSelection);
    window.removeEventListener("svetinje:place-selection-cleared", handleClearedSelection);
    window.removeEventListener("popstate", handlePopState);
  }, { once: true });
</script>
