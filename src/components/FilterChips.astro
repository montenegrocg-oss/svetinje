---
import InterfaceIcon from "./InterfaceIcon.astro";

interface Props {
  group: string;
  compact?: boolean;
}

const { group, compact = false } = Astro.props;
const filters = [
  { id: "all", label: "Све", icon: "grid" as const },
  { id: "monasteries", label: "Манастири", icon: "monastery" as const },
  { id: "churches", label: "Цркве", icon: "church" as const },
  { id: "holy-places", label: "Света мјеста", icon: "place" as const },
  { id: "routes", label: "Поклоничке руте", icon: "route" as const },
];
---

<div class:list={["filter-chips", { "filter-chips--compact": compact }]} data-filter-group={group} aria-label="Филтери каталога">
  {filters.map((filter, index) => (
    <button
      class="filter-chip"
      type="button"
      data-filter={filter.id}
      aria-pressed={index === 0 ? "true" : "false"}
    >
      <InterfaceIcon name={filter.icon} size={compact ? 16 : 17} />
      <span>{filter.label}</span>
    </button>
  ))}
</div>
