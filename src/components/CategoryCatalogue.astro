---
import type { PlaceCategory } from "../lib/place-filters";
import { categoryForPlaceType } from "../lib/place-filters";
import { isEditorialPreviewBuild, loadVisiblePlaces } from "../lib/content/publication";
import PlaceCard from "./PlaceCard.astro";

interface Props {
  heading: string;
  description: string;
  previewDescription?: string;
  category?: PlaceCategory;
  emptyHeading: string;
}

const { heading, description, previewDescription, category, emptyHeading } = Astro.props;
const visiblePlaces = await loadVisiblePlaces();
const editorialPreview = isEditorialPreviewBuild();
const places = category
  ? visiblePlaces.filter((place) => categoryForPlaceType(place.placeType) === category)
  : visiblePlaces;
const catalogueLabel = category ? `${heading} у радном приказу` : "Светиње у радном приказу";
---

<header class="page-hero compact">
  <div class="shell narrow">
    <p class="eyebrow">Каталог</p>
    <h1>{heading}</h1>
    <p>{editorialPreview && previewDescription ? previewDescription : description}</p>
  </div>
</header>

<section class="section catalogue-section">
  <div class="shell">
    {places.length === 0 ? (
      <div class="empty-state" role="status">
        <span class="empty-ornament" aria-hidden="true"></span>
        <p class="eyebrow">Каталог је у припреми</p>
        <h2>{emptyHeading}</h2>
        <p>Истраживачки и радни записи намјерно нису видљиви на овој страници.</p>
        <a class="text-link" href="/izvori/">Прочитај уређивачку политику <span aria-hidden="true">→</span></a>
      </div>
    ) : (
      <ul class="catalogue-grid editorial-catalogue" aria-label={catalogueLabel}>
        {places.map((place) => (
          <li><PlaceCard place={place} variant="catalogue" /></li>
        ))}
      </ul>
    )}
  </div>
</section>
