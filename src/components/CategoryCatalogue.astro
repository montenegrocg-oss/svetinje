---
import { categoryForPlaceType } from "../lib/place-filters";
import { loadVisiblePlaces } from "../lib/content/publication";
import type { PublicDiscoveryCategory } from "../lib/public-place-discovery";
import { selectPublicDiscoveryPlaces } from "../lib/public-place-discovery";
import { selectFeaturedCataloguePlaces } from "../lib/category-catalogue";
import { PLACES_PER_PAGE } from "../lib/explorer-pagination";
import { PLACE_AREAS } from "../lib/place-areas";
import CatalogueToolbar from "./CatalogueToolbar.astro";
import ExplorerPagination from "./ExplorerPagination.astro";
import PlaceCard from "./PlaceCard.astro";

interface Props {
  heading: string;
  description: string;
  category?: PublicDiscoveryCategory;
  emptyHeading: string;
}

const { heading, description, category, emptyHeading } = Astro.props;
const visiblePlaces = selectPublicDiscoveryPlaces(await loadVisiblePlaces());
const places = category
  ? visiblePlaces.filter((place) => categoryForPlaceType(place.placeType) === category)
  : visiblePlaces;
const isMonasteryCatalogue = category === "monasteries";
const featuredPlaces = isMonasteryCatalogue ? [] : selectFeaturedCataloguePlaces(places);
const featuredPlaceIds = new Set(featuredPlaces.map((place) => place.id));
const cataloguePlaces = places.filter((place) => !featuredPlaceIds.has(place.id));
const relevantAreaIds = new Set(places.flatMap((place) => place.browseAreaId ? [place.browseAreaId] : []));
const relevantAreas = PLACE_AREAS.filter((area) => relevantAreaIds.has(area.id));
const catalogueLabel = category ? heading : "Светиње";
const copy = category === "monasteries"
  ? {
      searchPlaceholder: "Претражите манастире…",
      statusPrefix: "Пронађено је",
      statusNoun: "манастира",
      featuredHeading: "Издвојени манастири",
      allHeading: "Сви манастири",
      countForms: ["православни манастир", "православна манастира", "православних манастира"],
    }
  : category === "churches"
    ? {
        searchPlaceholder: "Претражите храмове…",
        statusPrefix: "Пронађена",
        statusNoun: "храмова",
        featuredHeading: "Издвојени храмови",
        allHeading: "Сви храмови",
        countForms: ["православни храм", "православна храма", "православних храмова"],
      }
    : {
          searchPlaceholder: "Претражите светиње…",
          statusPrefix: "Пронађене",
          statusNoun: "светиња",
          featuredHeading: "Издвојене светиње",
          allHeading: "Све светиње",
          countForms: ["православну светињу", "православне светиње", "православних светиња"],
        };
const countFormIndex = places.length % 100 >= 11 && places.length % 100 <= 14
  ? 2
  : places.length % 10 === 1
    ? 0
    : places.length % 10 >= 2 && places.length % 10 <= 4
      ? 1
      : 2;
const countAwareDescription = `Истражите ${places.length} ${copy.countForms[countFormIndex] ?? copy.countForms[2]} широм Црне Горе.`;
---

<div
  data-category-catalogue
  data-catalogue-total={places.length}
  data-catalogue-page-size={PLACES_PER_PAGE}
  data-catalogue-status-noun={copy.statusNoun}
  data-catalogue-status-prefix={copy.statusPrefix}
>
  <header class="page-hero compact category-page-hero">
    <div class="shell narrow">
      <div class="category-page-hero__copy">
        <p class="eyebrow">Каталог</p>
        <h1>{heading}</h1>
        <span class="category-page-hero__rule" aria-hidden="true"></span>
        <p>{places.length > 0 ? countAwareDescription : description}</p>
      </div>
    </div>
  </header>

  <section class="section catalogue-section category-catalogue">
    <div class="shell">
      {places.length === 0 ? (
        <div class="empty-state" role="status">
          <span class="empty-ornament" aria-hidden="true"></span>
          <p class="eyebrow">Каталог је у припреми</p>
          <h2>{emptyHeading}</h2>
          <p>Садржај се објављује након завршене провјере.</p>
          <a class="text-link" href="/izvori/">Прочитај уређивачку политику <span aria-hidden="true">→</span></a>
        </div>
      ) : (
        <div class:list={["category-catalogue__body", isMonasteryCatalogue && "category-catalogue__body--monasteries"]}>
          {isMonasteryCatalogue && (
            <aside class="catalogue-sidebar" aria-label="Филтери каталога манастира">
              <CatalogueToolbar searchPlaceholder={copy.searchPlaceholder} areas={relevantAreas} />
            </aside>
          )}
          {!isMonasteryCatalogue && (
            <CatalogueToolbar
              searchPlaceholder={copy.searchPlaceholder}
              areas={relevantAreas}
              statusText={`${copy.statusPrefix} ${places.length} ${copy.statusNoun}`}
            />
          )}

          {!isMonasteryCatalogue && featuredPlaces.length > 0 && (
            <section class="catalogue-featured" data-catalogue-featured aria-labelledby="catalogue-featured-title">
              <div class="catalogue-section-heading">
                <p class="eyebrow">Избор уредништва</p>
                <h2 id="catalogue-featured-title">{copy.featuredHeading}</h2>
              </div>
              <ul class="catalogue-featured__grid">
                {featuredPlaces.map((place) => (
                  <li
                    data-catalogue-featured-item
                    data-place-area={place.browseAreaId ?? ""}
                    data-place-search={place.catalogueSearchText}
                  >
                    <PlaceCard place={place} variant="featured" />
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="catalogue-main" data-catalogue-main aria-labelledby="catalogue-main-title">
            <div class="catalogue-section-heading">
              <p class="eyebrow">Каталог</p>
              <h2 id="catalogue-main-title">{copy.allHeading}</h2>
              {isMonasteryCatalogue && (
                <p class="catalogue-main__status" data-catalogue-result-status role="status" aria-live="polite">
                  {copy.statusPrefix} {places.length} {copy.statusNoun}
                </p>
              )}
            </div>
            <ul class="catalogue-grid editorial-catalogue" aria-label={catalogueLabel} data-catalogue-grid>
              {cataloguePlaces.map((place, index) => (
                <li
                  data-catalogue-item
                  data-place-area={place.browseAreaId ?? ""}
                  data-place-search={place.catalogueSearchText}
                  hidden={index >= PLACES_PER_PAGE}
                >
                  <PlaceCard place={place} variant="catalogue" />
                </li>
              ))}
            </ul>
            <ExplorerPagination totalPlaces={cataloguePlaces.length} />
          </section>

          <section class="catalogue-filter-empty" data-catalogue-filter-empty hidden role="status" aria-live="polite">
            <h2>Нема резултата за изабране филтере.</h2>
            <button type="button" data-catalogue-reset>Очисти филтере</button>
          </section>
        </div>
      )}
    </div>
  </section>
</div>

<script>
  import { matchesCatalogueSearch } from "../lib/catalogue-search";
  import { pageCountForPlaces, PLACES_PER_PAGE } from "../lib/explorer-pagination";

  document.querySelectorAll<HTMLElement>("[data-category-catalogue]").forEach((catalogue) => {
    const items = [...catalogue.querySelectorAll<HTMLElement>("[data-catalogue-item]")];
    const featuredItems = [...catalogue.querySelectorAll<HTMLElement>("[data-catalogue-featured-item]")];
    const featuredSection = catalogue.querySelector<HTMLElement>("[data-catalogue-featured]");
    const mainSection = catalogue.querySelector<HTMLElement>("[data-catalogue-main]");
    const searchInput = catalogue.querySelector<HTMLInputElement>("[data-catalogue-search]");
    const areaSelect = catalogue.querySelector<HTMLSelectElement>("[data-catalogue-area]");
    const resultStatus = catalogue.querySelector<HTMLElement>("[data-catalogue-result-status]");
    const emptyState = catalogue.querySelector<HTMLElement>("[data-catalogue-filter-empty]");
    const resetButtons = [...catalogue.querySelectorAll<HTMLButtonElement>("[data-catalogue-reset]")];
    const pagination = catalogue.querySelector<HTMLElement>("[data-catalogue-pagination]");
    const previousButton = pagination?.querySelector<HTMLButtonElement>("[data-pagination-previous]");
    const nextButton = pagination?.querySelector<HTMLButtonElement>("[data-pagination-next]");
    const pageButtons = [...(pagination?.querySelectorAll<HTMLButtonElement>("[data-pagination-page]") ?? [])];
    const status = pagination?.querySelector<HTMLElement>("[data-pagination-status]");
    const statusNoun = catalogue.dataset.catalogueStatusNoun ?? "резултата";
    const statusPrefix = catalogue.dataset.catalogueStatusPrefix ?? "Пронађено";
    let matchedItems = [...items];
    let currentPage = 1;

    const renderPage = (requestedPage: number) => {
      const totalPages = pageCountForPlaces(matchedItems.length);
      currentPage = totalPages === 0 ? 1 : Math.min(Math.max(1, requestedPage), totalPages);
      const pageStart = (currentPage - 1) * PLACES_PER_PAGE;
      const pageEnd = pageStart + PLACES_PER_PAGE;
      items.forEach((item) => { item.hidden = true; });
      matchedItems.forEach((item, index) => {
        item.hidden = index < pageStart || index >= pageEnd;
      });
      if (previousButton) previousButton.disabled = currentPage === 1;
      if (nextButton) nextButton.disabled = currentPage === totalPages;
      pageButtons.forEach((button) => {
        const page = Number(button.dataset.paginationPage);
        button.hidden = page > totalPages;
        if (page === currentPage) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
      if (pagination) {
        pagination.hidden = totalPages <= 1;
        pagination.dataset.totalPages = String(totalPages);
      }
      if (status && totalPages > 0) status.textContent = `Страница ${currentPage} од ${totalPages}`;
      catalogue.dataset.cataloguePage = String(currentPage);
    };

    const matchesFilters = (item: HTMLElement, query: string, areaId: string) =>
      matchesCatalogueSearch(item.dataset.placeSearch ?? "", query)
      && (!areaId || item.dataset.placeArea === areaId);

    const applyFilters = () => {
      const query = searchInput?.value ?? "";
      const areaId = areaSelect?.value ?? "";
      const matchedFeaturedItems = featuredItems.filter((item) => matchesFilters(item, query, areaId));
      matchedItems = items.filter((item) => matchesFilters(item, query, areaId));
      featuredItems.forEach((item) => { item.hidden = !matchedFeaturedItems.includes(item); });
      if (featuredSection) featuredSection.hidden = matchedFeaturedItems.length === 0;
      if (mainSection) mainSection.hidden = matchedItems.length === 0;
      const matchedTotal = matchedFeaturedItems.length + matchedItems.length;
      if (emptyState) emptyState.hidden = matchedTotal !== 0;
      const hasFilters = Boolean(query.trim() || areaId);
      if (resultStatus) {
        resultStatus.textContent = `${statusPrefix} ${matchedTotal} ${statusNoun}`;
      }
      resetButtons.forEach((button) => {
        button.hidden = !hasFilters;
        button.disabled = !hasFilters;
      });
      currentPage = 1;
      renderPage(1);
    };

    previousButton?.addEventListener("click", () => renderPage(currentPage - 1));
    nextButton?.addEventListener("click", () => renderPage(currentPage + 1));
    pageButtons.forEach((button) => {
      button.addEventListener("click", () => renderPage(Number(button.dataset.paginationPage)));
    });
    searchInput?.addEventListener("input", applyFilters);
    areaSelect?.addEventListener("change", applyFilters);
    resetButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (areaSelect) areaSelect.value = "";
        applyFilters();
        searchInput?.focus();
      });
    });
    applyFilters();
  });
</script>
