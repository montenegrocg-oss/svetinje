---
import type { VisiblePlace } from "../lib/content/publication";
import type { VisibleRoute } from "../lib/content/routes";
import { mapEditorialRoutes } from "../lib/map-editorial-routes";
import { categoryForPlaceType } from "../lib/place-filters";
import { placeDetailRoot, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";

interface Props {
  places?: VisiblePlace[];
  routes?: VisibleRoute[];
  layout?: "homepage" | "full";
  locale?: Locale;
}

const { places = [], routes = [], layout = "homepage", locale = "sr" } = Astro.props;
const mapCopy = locale === "ru" ? { fallback: "Стилизованная карта Черногории без меток святынь.", region: "Интерактивная карта Черногории", loading: "Загрузка карты…", slowLoading: "Карта всё ещё загружается…", unavailable: "Интерактивная карта сейчас недоступна.", attribution: "Источники картографических данных", photo: "Авторская фотография будет добавлена", cluster: "святынь — приблизить карту", country: ["ЧЕРНО", "ГОРИЯ"], sea: "АДРИАТИЧЕСКОЕ МОРЕ", neighbours: ["СЕРБИЯ", "АЛБАНИЯ", "БОСНИЯ И ГЕРЦЕГОВИНА", "ХОРВАТИЯ"] } : locale === "en" ? { fallback: "A stylised map of Montenegro without holy-place markers.", region: "Interactive map of Montenegro", loading: "Loading map…", slowLoading: "The map is still loading…", unavailable: "The interactive map is currently unavailable.", attribution: "Map data sources", photo: "An original photograph will be added", cluster: "holy places — zoom in", country: ["MONTE", "NEGRO"], sea: "ADRIATIC SEA", neighbours: ["SERBIA", "ALBANIA", "BOSNIA AND HERZEGOVINA", "CROATIA"] } : { fallback: "Стилизована картографска површина Црне Горе без ознака светиња.", region: "Интерактивна карта Црне Горе", loading: "Учитавање карте…", slowLoading: "Карта се још учитава…", unavailable: "Интерактивна карта тренутно није доступна.", attribution: "Извори картографских података", photo: "Ауторска фотографија биће додата", cluster: "светиње — приближи карту", country: ["ЦРНА", "ГОРА"], sea: "ЈАДРАНСКО МОРЕ", neighbours: ["СРБИЈА", "АЛБАНИЈА", "БОСНА И ХЕРЦЕГОВИНА", "ХРВАТСКА"] };
const hasMapTilerKey = Boolean(import.meta.env.PUBLIC_MAPTILER_KEY?.trim());
const markerPlaces = places.flatMap((place) =>
  Number.isFinite(place.latitude) && Number.isFinite(place.longitude)
    ? [{
        id: place.id,
        slug: place.slug,
        name: place.name,
        placeType: place.placeType,
        typeLabel: place.typeLabel,
        category: categoryForPlaceType(place.placeType),
        municipality: place.municipality,
        settlement: place.settlement,
        latitude: place.latitude as number,
        longitude: place.longitude as number,
        previewImageSrc: place.previewImageSrc,
        previewImageAlt: place.previewImageAlt,
      }]
    : [],
);
const markerPayload = JSON.stringify(markerPlaces).replaceAll("<", "\\u003c");
const routePayload = JSON.stringify(mapEditorialRoutes(routes)).replaceAll("<", "\\u003c");
const routeCopyPayload = JSON.stringify(publicCopy[locale].homepage.mapControls.routeSummary).replaceAll("<", "\\u003c");
---
<div
  class="map-canvas"
  data-home-map
  data-map-layout={layout}
  data-testid="map-canvas"
  data-map-state={hasMapTilerKey ? "loading" : "fallback"}
  data-map-load-status={hasMapTilerKey ? "pending" : undefined}
  data-place-detail-root={placeDetailRoot[locale]}
  data-open-page-label={publicCopy[locale].openPage}
  data-photo-placeholder={mapCopy.photo}
  data-cluster-label={mapCopy.cluster}
  data-map-locale={locale}
>
  <div
    class="map-fallback"
    data-map-fallback
    role="img"
    hidden={hasMapTilerKey}
    aria-hidden={hasMapTilerKey ? "true" : "false"}
    aria-label={mapCopy.fallback}
  >
    <svg class="map-art" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <filter id="map-grain" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="12" result="noise" />
        <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
        <feComponentTransfer in="mono"><feFuncA type="table" tableValues="0 0.055" /></feComponentTransfer>
      </filter>
      <clipPath id="montenegro-clip">
        <path d="M474 68 550 55 610 82 680 72 741 112 782 157 778 212 818 257 791 310 747 344 731 397 689 423 664 484 609 511 566 493 528 535 479 515 453 467 404 449 376 406 336 376 359 320 328 275 355 226 375 169 423 143Z" />
      </clipPath>
      <linearGradient id="sea-fill" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#c9dbe0" />
        <stop offset="1" stop-color="#91bac7" />
      </linearGradient>
      <linearGradient id="terrain-fill" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#dbe2c8" />
        <stop offset="0.55" stop-color="#c8d6b7" />
        <stop offset="1" stop-color="#e8dfc5" />
      </linearGradient>
    </defs>

    <rect width="1200" height="650" fill="#ece7da" />
    <path d="M0 448C146 413 252 421 358 372c56-26 91-43 129-41l90 319H0Z" fill="url(#sea-fill)" />
    <path d="M0 472c158-44 273-22 393-94M0 530c181-50 313-23 430-115M25 588c185-46 315-28 452-124" fill="none" stroke="#fff" stroke-opacity=".24" />

    <g opacity=".45" fill="none" stroke="#baa98b" stroke-width="1">
      <path d="M112 100c128 52 184 7 289 47s188 28 285-11 212-8 354 78" />
      <path d="M86 152c149 43 214 16 321 54s195 18 302-13 230 3 373 72" />
      <path d="M212 15c22 104-41 185 15 267s66 165 29 298" />
      <path d="M948 22c-41 102 24 187-34 270s-68 160-29 298" />
    </g>

    <path
      d="M474 68 550 55 610 82 680 72 741 112 782 157 778 212 818 257 791 310 747 344 731 397 689 423 664 484 609 511 566 493 528 535 479 515 453 467 404 449 376 406 336 376 359 320 328 275 355 226 375 169 423 143Z"
      fill="url(#terrain-fill)"
      stroke="#6c7764"
      stroke-width="3"
    />

    <g clip-path="url(#montenegro-clip)" fill="none" stroke-linecap="round">
      <path d="M302 178c102-69 196-52 279-12s166 45 270-22M299 226c105-65 207-42 285-5s168 38 273-31M305 284c103-54 192-35 280 6s170 33 262-30M316 351c102-54 181-28 268 8s164 29 242-21M348 416c94-44 160-20 234 15s139 25 205-10M389 474c69-28 123-11 185 16s105 20 159 1" stroke="#97aa86" stroke-width="10" opacity=".38" />
      <path d="M423 70c23 91 77 141 73 224s34 154 104 225M548 42c-18 96 31 151 29 235s31 159 94 232M690 62c-38 89-6 145-7 215s20 117 73 177" stroke="#fff" stroke-width="2" opacity=".45" />
      <path d="M365 380c89-52 175-54 265-20s129 18 170-11M396 215c87-24 165-8 227 25s126 41 178 19" stroke="#d8b574" stroke-width="2" stroke-dasharray="4 7" opacity=".8" />
    </g>

    <g fill="#33443f" font-family="Georgia, serif" letter-spacing="7">
      <text x="509" y="287" font-size="30">{mapCopy.country[0]}</text>
      <text x="516" y="326" font-size="30">{mapCopy.country[1]}</text>
    </g>
    <g fill="#66716b" font-family="system-ui, sans-serif" font-size="13" font-weight="650" letter-spacing="2">
      <text x="81" y="470" transform="rotate(-17 81 470)">{mapCopy.sea}</text>
      <text x="781" y="84">{mapCopy.neighbours[0]}</text>
      <text x="835" y="430">{mapCopy.neighbours[1]}</text>
      <text x="292" y="87">{mapCopy.neighbours[2]}</text>
      <text x="267" y="359">{mapCopy.neighbours[3]}</text>
    </g>
    <rect width="1200" height="650" filter="url(#map-grain)" opacity=".65" />
    </svg>

  </div>

  <div
    class="map-renderer"
    data-map-renderer
    hidden={!hasMapTilerKey}
    aria-hidden={hasMapTilerKey ? "false" : "true"}
  >
    <div
      id="montenegro-map"
      class="maplibre-map"
      data-testid="maplibre-container"
      role="region"
      aria-label={mapCopy.region}
    ></div>
  </div>

  <div
    class="map-loading-surface"
    data-map-loading-surface
    hidden={!hasMapTilerKey}
    aria-hidden={hasMapTilerKey ? "false" : "true"}
  >
    <p class="map-loading-status" data-map-loading-status data-map-slow-message={mapCopy.slowLoading} role="status" aria-live="polite">{mapCopy.loading}</p>
  </div>

  <p
    class="map-fallback-notice"
    data-map-fallback-notice
    role="status"
    hidden={hasMapTilerKey}
  >
    {mapCopy.unavailable}
  </p>

  <div class="map-attribution" data-map-attribution aria-label={mapCopy.attribution} hidden>
    <a href="https://www.maptiler.com/copyright/" target="_blank" rel="noopener noreferrer">© MapTiler</a>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>
  </div>

  <script type="application/json" data-map-place-data set:html={markerPayload} is:inline />
  {routes.length > 0 && <script type="application/json" data-map-route-data set:html={routePayload} is:inline />}
  {routes.length > 0 && <script type="application/json" data-map-route-copy set:html={routeCopyPayload} is:inline />}
</div>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import type { LngLatBoundsLike, Map as MapLibreMap, Marker as MapLibreMarker, PaddingOptions } from "maplibre-gl";
  import { clusterProjectedMarkers, getClusterExpansionZoom, type ProjectedMarker } from "../lib/map-marker-clustering";
  import { createInitialMap, isFatalInitialStyleError, watchInitialMapLoad } from "../lib/map-load-lifecycle";
  import { resolveMarkerAsset } from "../lib/map-marker-assets";
  import { getMapPopupPanOffset } from "../lib/map-popup-positioning";

  const MAPTILER_KEY = import.meta.env.PUBLIC_MAPTILER_KEY?.trim();
  const MAP_STYLE_URL = MAPTILER_KEY
    ? `https://api.maptiler.com/maps/019fc7d8-717c-701d-9ca5-a53d9438d3ce/style.json?key=${encodeURIComponent(MAPTILER_KEY)}`
    : "";
  const MARKER_CLUSTER_RADIUS = 52;
  const MARKER_CLUSTER_MAX_ZOOM = 12;
  interface MarkerPlace {
    id: string;
    slug: string;
    name: string;
    placeType: string;
    typeLabel: string;
    category: string | null;
    municipality?: string;
    settlement?: string;
    latitude: number;
    longitude: number;
    previewImageSrc?: string;
    previewImageAlt?: string;
  }

  interface EditorialRoute {
    id: string;
    title: string;
    routeType: "hiking";
    trackUrl: string;
    detailUrl: string;
    metrics: { distanceM: number; ascentM?: number; durationMinutes?: number };
    difficulty: "easy" | "moderate" | "demanding";
  }

  interface EditorialRouteCopy {
    distance: string;
    duration: string;
    ascent: string;
    difficulty: string;
    view: string;
    hours: string;
    minutes: string;
    difficulties: Record<EditorialRoute["difficulty"], string>;
  }

  const EDITORIAL_ROUTE_SOURCE_ID = "editorial-walking-routes";
  const EDITORIAL_ROUTE_LAYER_IDS = [
    "editorial-walking-routes-casing",
    "editorial-walking-routes-line",
    "editorial-walking-routes-hit",
  ] as const;

  const MONTENEGRO_BOUNDS: LngLatBoundsLike = [
    [18.42, 41.8],
    [20.36, 43.57],
  ];

  const getInitialPadding = (width: number, layout: "homepage" | "full"): PaddingOptions => {
    if (layout === "full") {
      if (width >= 1088) return { top: 56, right: 56, bottom: 56, left: 56 };
      if (width >= 768) return { top: 42, right: 42, bottom: 42, left: 42 };
      return { top: 22, right: 22, bottom: 22, left: 22 };
    }
    if (width >= 1088) return { top: 78, right: 28, bottom: 30, left: 292 };
    if (width >= 768) return { top: 135, right: 26, bottom: 34, left: 245 };
    return { top: 62, right: 14, bottom: 26, left: 14 };
  };

  const initialiseHomepageMap = () => {
    const root = document.querySelector<HTMLElement>("[data-home-map]");
    if (!root || root.dataset.mapInitialised === "true") return;

    root.dataset.mapInitialised = "true";
    const mapLayout = root.dataset.mapLayout === "full" ? "full" : "homepage";
    const renderer = root.querySelector<HTMLElement>("[data-map-renderer]");
    const fallback = root.querySelector<HTMLElement>("[data-map-fallback]");
    const loadingSurface = root.querySelector<HTMLElement>("[data-map-loading-surface]");
    const loadingStatus = root.querySelector<HTMLElement>("[data-map-loading-status]");
    const fallbackNotice = root.querySelector<HTMLElement>("[data-map-fallback-notice]");
    const attribution = root.querySelector<HTMLElement>("[data-map-attribution]");
    const stage = root.closest<HTMLElement>(".map-stage");
    const zoomInButton = stage?.querySelector<HTMLButtonElement>("[data-map-zoom-in]");
    const zoomOutButton = stage?.querySelector<HTMLButtonElement>("[data-map-zoom-out]");
    const resetButton = stage?.querySelector<HTMLButtonElement>("[data-map-reset]");
    const routeToggleButtons = [...(stage?.querySelectorAll<HTMLButtonElement>("[data-route-toggle]") ?? [])];
    const mapContainer = root.querySelector<HTMLElement>("#montenegro-map");
    const markerDataElement = root.querySelector<HTMLScriptElement>("[data-map-place-data]");
    const routeDataElement = root.querySelector<HTMLScriptElement>("[data-map-route-data]");
    const routeCopyElement = root.querySelector<HTMLScriptElement>("[data-map-route-copy]");
    const placeDetailRoot = root.dataset.placeDetailRoot ?? "/svetinje/";
    const openPageLabel = root.dataset.openPageLabel ?? "Open page";
    const photoPlaceholder = root.dataset.photoPlaceholder ?? "";
    const clusterLabel = root.dataset.clusterLabel ?? "places — zoom in";
    const mapLocale = root.dataset.mapLocale === "ru" ? "ru" : root.dataset.mapLocale === "en" ? "en" : "sr";
    const markerPlaces: MarkerPlace[] = markerDataElement?.textContent
      ? JSON.parse(markerDataElement.textContent) as MarkerPlace[]
      : [];
    const editorialRoutes: EditorialRoute[] = routeDataElement?.textContent
      ? JSON.parse(routeDataElement.textContent) as EditorialRoute[]
      : [];
    const routeCopy = JSON.parse(routeCopyElement?.textContent ?? "{}") as EditorialRouteCopy;

    const setControlsEnabled = (enabled: boolean) => {
      [zoomInButton, zoomOutButton, resetButton, ...routeToggleButtons].forEach((button) => {
        if (button) button.disabled = !enabled;
      });
    };

    let map: MapLibreMap | undefined;
    let removed = false;
    let stopWatchingInitialLoad = () => {};
    let removeActiveMap = () => {};

    const showFallback = () => {
      stopWatchingInitialLoad();
      if (map && !removed) removeActiveMap();
      root.dataset.mapState = "fallback";
      delete root.dataset.mapLoadStatus;
      if (renderer) renderer.hidden = true;
      if (fallback) fallback.hidden = false;
      if (loadingSurface) loadingSurface.hidden = true;
      renderer?.setAttribute("aria-hidden", "true");
      fallback?.setAttribute("aria-hidden", "false");
      loadingSurface?.setAttribute("aria-hidden", "true");
      loadingStatus?.setAttribute("aria-hidden", "true");
      if (fallbackNotice) fallbackNotice.hidden = false;
      if (attribution) attribution.hidden = true;
      setControlsEnabled(false);
    };

    if (!MAPTILER_KEY || !mapContainer || !renderer) {
      showFallback();
      return;
    }

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mobileTouch = window.matchMedia("(max-width: 47.999rem) and (pointer: coarse)").matches;
    map = createInitialMap({
      available: true,
      onFatal: showFallback,
      create: () => new maplibregl.Map({
        container: mapContainer,
        style: MAP_STYLE_URL,
        center: [19.25, 42.7],
        zoom: 6,
        attributionControl: false,
        cooperativeGestures: !mobileTouch,
        dragPan: true,
        touchZoomRotate: true,
        dragRotate: false,
        pitchWithRotate: false,
        fadeDuration: reducedMotion.matches ? 0 : 300,
        minZoom: 4,
        maxZoom: 20,
      }),
    });

    if (!map) return;

    map.touchZoomRotate.disableRotation();
    let visitorMovedMap = false;
    let resizeTimer: number | undefined;
    const markers: MapLibreMarker[] = [];
    const markerLinks: HTMLAnchorElement[] = [];
    const markerRecords: { place: MarkerPlace; link: HTMLAnchorElement }[] = [];
    let clusterMarkers: MapLibreMarker[] = [];
    let visibleMarkerIds = new Set(markerPlaces.map(({ id }) => id));
    const animationDuration = () => (reducedMotion.matches ? 0 : 420);
    const previewPopup = new maplibregl.Popup({
      closeButton: false,
      closeOnClick: false,
      focusAfterOpen: false,
      maxWidth: "240px",
      offset: 45,
      className: "holy-place-popup",
    });
    const routePopup = new maplibregl.Popup({
      closeButton: true,
      closeOnClick: true,
      focusAfterOpen: true,
      maxWidth: "280px",
      offset: 8,
      className: "editorial-route-popup",
    });
    let previewCloseTimer: number | undefined;
    let previewVisibilityRequest = 0;
    let activePreview: {
      place: MarkerPlace;
      link: HTMLAnchorElement;
      card: HTMLElement;
      pinned: boolean;
    } | undefined;

    const clearPreviewCloseTimer = () => {
      window.clearTimeout(previewCloseTimer);
      previewCloseTimer = undefined;
    };

    const closePreview = () => {
      clearPreviewCloseTimer();
      previewVisibilityRequest += 1;
      root.removeAttribute("data-popup-open");
      if (!activePreview) return;
      activePreview.link.setAttribute("aria-expanded", "false");
      activePreview.link.removeAttribute("aria-controls");
      activePreview = undefined;
      previewPopup.remove();
    };

    const schedulePreviewClose = () => {
      clearPreviewCloseTimer();
      if (!activePreview || activePreview.pinned) return;
      previewCloseTimer = window.setTimeout(closePreview, 200);
    };

    const createPreviewCard = (place: MarkerPlace): HTMLElement => {
      const card = document.createElement("article");
      const cardId = `map-place-preview-${place.id}`;
      const titleId = `${cardId}-title`;
      card.id = cardId;
      card.className = "map-place-preview";
      card.setAttribute("role", "group");
      card.setAttribute("aria-labelledby", titleId);

      const media = document.createElement("div");
      media.className = "map-place-preview__media";
      if (place.previewImageSrc) {
        const image = document.createElement("img");
        image.className = "map-place-preview__image";
        image.src = place.previewImageSrc;
        image.alt = place.previewImageAlt ?? place.name;
        image.decoding = "async";
        media.append(image);
      } else {
        const ornament = document.createElement("span");
        ornament.className = "map-place-preview__ornament";
        ornament.setAttribute("aria-hidden", "true");
        const notice = document.createElement("span");
        notice.className = "map-place-preview__media-note";
        notice.textContent = photoPlaceholder;
        media.append(ornament, notice);
      }

      const body = document.createElement("div");
      body.className = "map-place-preview__body";
      const type = document.createElement("p");
      type.className = "map-place-preview__type";
      type.textContent = place.typeLabel;
      const title = document.createElement("h3");
      title.id = titleId;
      title.className = "map-place-preview__title";
      title.textContent = place.name;
      body.append(type, title);

      const location = [place.municipality, place.settlement].filter(Boolean).join(" · ");
      if (location) {
        const locationText = document.createElement("p");
        locationText.className = "map-place-preview__location";
        locationText.textContent = location;
        body.append(locationText);
      }

      const link = document.createElement("a");
      link.className = "map-place-preview__link";
      link.href = `${placeDetailRoot}${encodeURIComponent(place.slug)}/`;
      link.textContent = openPageLabel;
      const arrow = document.createElement("span");
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "↗";
      link.append(arrow);
      body.append(link);
      card.append(media, body);

      card.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        clearPreviewCloseTimer();
      });
      card.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "mouse") return;
        schedulePreviewClose();
      });
      card.addEventListener("focusin", clearPreviewCloseTimer);
      card.addEventListener("focusout", (event) => {
        if (event.relatedTarget instanceof Node && card.contains(event.relatedTarget)) return;
        schedulePreviewClose();
      });
      return card;
    };

    const keepPreviewVisibleOnMobile = (requestId: number, retryAfterPan: boolean) => {
      if (requestId !== previewVisibilityRequest || !window.matchMedia("(max-width: 47.999rem)").matches) return;

      const mobileNavigation = document.querySelector<HTMLDetailsElement>(".mobile-navigation[open]");
      if (mobileNavigation) mobileNavigation.open = false;

      const popupElement = previewPopup.getElement();
      if (!popupElement) return;

      const mapRect = root.getBoundingClientRect();
      const viewportWidth = document.documentElement.clientWidth;
      const viewportHeight = window.innerHeight;
      const safeGap = 12;
      let safeTop = Math.max(0, mapRect.top);

      [
        document.querySelector<HTMLElement>(".site-header"),
        stage?.querySelector<HTMLElement>(".map-actions"),
      ].forEach((overlay) => {
        if (!overlay) return;
        const overlayRect = overlay.getBoundingClientRect();
        const overlapsMap = overlayRect.right > mapRect.left
          && overlayRect.left < mapRect.right
          && overlayRect.bottom > mapRect.top
          && overlayRect.top < mapRect.bottom;
        if (overlapsMap) safeTop = Math.max(safeTop, overlayRect.bottom);
      });

      const safeRect = {
        top: safeTop + safeGap,
        right: Math.min(viewportWidth, mapRect.right) - safeGap,
        bottom: Math.min(viewportHeight, mapRect.bottom) - safeGap,
        left: Math.max(0, mapRect.left) + safeGap,
      };
      const panOffset = getMapPopupPanOffset(popupElement.getBoundingClientRect(), safeRect);
      if (panOffset[0] === 0 && panOffset[1] === 0) return;

      visitorMovedMap = true;
      map.panBy(panOffset, { duration: animationDuration() });
      if (retryAfterPan) {
        window.setTimeout(
          () => keepPreviewVisibleOnMobile(requestId, false),
          animationDuration() + 50,
        );
      }
    };

    const schedulePreviewVisibilityCheck = () => {
      const requestId = ++previewVisibilityRequest;
      window.requestAnimationFrame(() => keepPreviewVisibleOnMobile(requestId, true));
    };

    const openPreview = (place: MarkerPlace, link: HTMLAnchorElement, pinned = false) => {
      clearPreviewCloseTimer();
      routePopup.remove();
      if (activePreview?.place.id === place.id) {
        root.dataset.popupOpen = "true";
        if (pinned) activePreview.pinned = true;
        schedulePreviewVisibilityCheck();
        return;
      }
      closePreview();
      const card = createPreviewCard(place);
      link.setAttribute("aria-expanded", "true");
      link.setAttribute("aria-controls", card.id);
      previewPopup
        .setLngLat([place.longitude, place.latitude])
        .setDOMContent(card)
        .addTo(map);
      activePreview = { place, link, card, pinned };
      root.dataset.popupOpen = "true";
      schedulePreviewVisibilityCheck();
    };

    markerPlaces.forEach((place) => {
      const link = document.createElement("a");
      link.href = `${placeDetailRoot}${encodeURIComponent(place.slug)}/`;
      link.className = "holy-place-marker";
      link.dataset.mapMarker = place.id;
      link.dataset.placeCategory = place.category ?? "";
      link.setAttribute("aria-label", `${place.name} — ${openPageLabel}`);
      link.setAttribute("aria-expanded", "false");
      const markerAsset = resolveMarkerAsset(place.placeType);
      if (markerAsset) {
        const markerImage = document.createElement("img");
        markerImage.className = "holy-place-marker__image";
        markerImage.src = markerAsset.src;
        markerImage.alt = "";
        markerImage.width = markerAsset.width;
        markerImage.height = markerAsset.height;
        markerImage.decoding = "async";
        markerImage.draggable = false;
        markerImage.setAttribute("aria-hidden", "true");
        link.append(markerImage);
      } else {
        const markerFallback = document.createElement("span");
        markerFallback.className = "holy-place-marker__fallback";
        markerFallback.setAttribute("aria-hidden", "true");
        markerFallback.append(document.createElement("i"));
        link.append(markerFallback);
      }
      link.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        openPreview(place, link);
      });
      link.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "mouse") return;
        schedulePreviewClose();
      });
      let suppressTouchClickUntil = 0;
      link.addEventListener("pointerup", (event) => {
        if (event.pointerType !== "touch" && event.pointerType !== "pen") return;
        event.preventDefault();
        suppressTouchClickUntil = Date.now() + 800;
        openPreview(place, link, true);
      });
      link.addEventListener("click", (event) => {
        const pointerType = event instanceof PointerEvent ? event.pointerType : "";
        const isTouchActivation = pointerType === "touch" || pointerType === "pen" || Date.now() < suppressTouchClickUntil;
        if (!isTouchActivation) return;
        event.preventDefault();
        suppressTouchClickUntil = 0;
      });
      link.addEventListener("focus", () => openPreview(place, link));
      link.addEventListener("focusout", (event) => {
        if (event.relatedTarget instanceof Node && activePreview?.card.contains(event.relatedTarget)) return;
        schedulePreviewClose();
      });
      markerLinks.push(link);
      const marker = new maplibregl.Marker({ element: link, anchor: "bottom" })
        .setLngLat([place.longitude, place.latitude])
        .addTo(map);
      markers.push(marker);
      markerRecords.push({ place, link });
    });

    let routesVisible = false;
    let routeLayerPromise: Promise<void> | undefined;
    const routeBounds = new maplibregl.LngLatBounds();

    const appendRouteMetric = (list: HTMLDListElement, labelText: string, valueText: string) => {
      const row = document.createElement("div");
      const label = document.createElement("dt");
      const value = document.createElement("dd");
      label.textContent = labelText;
      value.textContent = valueText;
      row.append(label, value);
      list.append(row);
    };

    const formatRouteDuration = (minutes: number) => {
      const parts: string[] = [];
      const hours = Math.floor(minutes / 60);
      if (hours > 0) parts.push(`${hours} ${routeCopy.hours}`);
      if (minutes % 60 > 0 || parts.length === 0) parts.push(`${minutes % 60} ${routeCopy.minutes}`);
      return parts.join(" ");
    };

    const createRouteSummary = (route: EditorialRoute) => {
      const card = document.createElement("article");
      card.className = "map-route-summary";
      const title = document.createElement("h3");
      title.textContent = route.title;
      const metrics = document.createElement("dl");
      metrics.className = "map-route-summary__metrics";
      const numberLocale = mapLocale === "sr" ? "sr-ME" : mapLocale;
      appendRouteMetric(metrics, routeCopy.distance, `${(route.metrics.distanceM / 1000).toLocaleString(numberLocale, { maximumFractionDigits: 1 })} km`);
      if (route.metrics.durationMinutes !== undefined) appendRouteMetric(metrics, routeCopy.duration, formatRouteDuration(route.metrics.durationMinutes));
      if (route.metrics.ascentM !== undefined) appendRouteMetric(metrics, routeCopy.ascent, `+${route.metrics.ascentM.toLocaleString(numberLocale)} m`);
      appendRouteMetric(metrics, routeCopy.difficulty, routeCopy.difficulties[route.difficulty]);
      const link = document.createElement("a");
      link.className = "map-route-summary__link";
      link.href = route.detailUrl;
      link.textContent = routeCopy.view;
      const arrow = document.createElement("span");
      arrow.setAttribute("aria-hidden", "true");
      arrow.textContent = "→";
      link.append(arrow);
      card.append(title, metrics, link);
      return card;
    };

    const ensureRouteLayers = () => {
      routeLayerPromise ??= (async () => {
        const features: GeoJSON.Feature<GeoJSON.LineString, { id: string }>[] = [];
        for (const route of editorialRoutes) {
          const response = await fetch(route.trackUrl, { credentials: "same-origin" });
          if (!response.ok) throw new Error("Editorial route track unavailable");
          const track = await response.json() as GeoJSON.Feature<GeoJSON.LineString>;
          if (track.type !== "Feature" || track.geometry?.type !== "LineString" || track.geometry.coordinates.length < 2) {
            throw new Error("Editorial route track is invalid");
          }
          track.geometry.coordinates.forEach((coordinate) => routeBounds.extend([coordinate[0]!, coordinate[1]!]));
          features.push({ ...track, properties: { id: route.id } });
        }
        map.addSource(EDITORIAL_ROUTE_SOURCE_ID, {
          type: "geojson",
          data: { type: "FeatureCollection", features },
        });
        map.addLayer({
          id: EDITORIAL_ROUTE_LAYER_IDS[0], type: "line", source: EDITORIAL_ROUTE_SOURCE_ID,
          layout: { visibility: "none", "line-cap": "round", "line-join": "round" },
          paint: { "line-color": "#0a2944", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 4.5, 13, 7], "line-opacity": 0.72 },
        });
        map.addLayer({
          id: EDITORIAL_ROUTE_LAYER_IDS[1], type: "line", source: EDITORIAL_ROUTE_SOURCE_ID,
          layout: { visibility: "none", "line-cap": "round", "line-join": "round" },
          paint: { "line-color": "#d0ab61", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 2.4, 13, 4], "line-opacity": 0.96 },
        });
        map.addLayer({
          id: EDITORIAL_ROUTE_LAYER_IDS[2], type: "line", source: EDITORIAL_ROUTE_SOURCE_ID,
          layout: { visibility: "none", "line-cap": "round", "line-join": "round" },
          paint: { "line-color": "#d0ab61", "line-width": 18, "line-opacity": 0.01 },
        });
        map.on("mouseenter", EDITORIAL_ROUTE_LAYER_IDS[2], () => { map.getCanvas().style.cursor = "pointer"; });
        map.on("mouseleave", EDITORIAL_ROUTE_LAYER_IDS[2], () => { map.getCanvas().style.cursor = ""; });
        map.on("click", (event) => {
          if (!routesVisible || !map.getLayer(EDITORIAL_ROUTE_LAYER_IDS[2])) return;
          const hitPadding = 10;
          const feature = map.queryRenderedFeatures([
            [event.point.x - hitPadding, event.point.y - hitPadding],
            [event.point.x + hitPadding, event.point.y + hitPadding],
          ], { layers: EDITORIAL_ROUTE_LAYER_IDS.slice(0, 2) })[0];
          const routeId = feature?.properties?.id;
          const route = editorialRoutes.find((candidate) => candidate.id === routeId);
          if (!route) return;
          closePreview();
          const popupLngLat = root.clientWidth < 768
            ? map.unproject([map.getCanvas().clientWidth / 2, 112])
            : event.lngLat;
          routePopup.setLngLat(popupLngLat).setDOMContent(createRouteSummary(route)).addTo(map);
        });
      })();
      return routeLayerPromise;
    };

    const syncRouteToggles = () => routeToggleButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(routesVisible));
      button.setAttribute("aria-busy", "false");
    });

    const handleRouteToggle = async () => {
      const showRoutes = !routesVisible;
      routeToggleButtons.forEach((button) => {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
      });
      try {
        if (showRoutes) await ensureRouteLayers();
        if (removed) return;
        EDITORIAL_ROUTE_LAYER_IDS.forEach((layerId) => {
          if (map.getLayer(layerId)) map.setLayoutProperty(layerId, "visibility", showRoutes ? "visible" : "none");
        });
        routesVisible = showRoutes;
        if (!showRoutes) routePopup.remove();
        if (showRoutes && !routeBounds.isEmpty()) {
          visitorMovedMap = true;
          map.fitBounds(routeBounds, { padding: getInitialPadding(root.clientWidth, mapLayout), maxZoom: 13, duration: animationDuration() });
        }
      } catch {
        routesVisible = false;
        routePopup.remove();
      } finally {
        if (!removed) routeToggleButtons.forEach((button) => { button.disabled = false; });
        syncRouteToggles();
      }
    };
    const removeClusterMarkers = () => {
      clusterMarkers.forEach((marker) => marker.remove());
      clusterMarkers = [];
    };
    const updateMarkerClusters = () => {
      removeClusterMarkers();
      const visibleRecords = markerRecords.filter(({ place }) => visibleMarkerIds.has(place.id));
      markerRecords.forEach(({ place, link }) => { link.hidden = !visibleMarkerIds.has(place.id); });
      if (map.getZoom() >= MARKER_CLUSTER_MAX_ZOOM || visibleRecords.length < 2) return;

      const projectedRecords: ProjectedMarker<(typeof markerRecords)[number]>[] = visibleRecords.map((record) => {
        const point = map.project([record.place.longitude, record.place.latitude]);
        return { item: record, x: point.x, y: point.y };
      });

      clusterProjectedMarkers(projectedRecords, MARKER_CLUSTER_RADIUS).forEach((group) => {
        if (group.length < 2) return;
        group.forEach(({ item }) => { item.link.hidden = true; });
        if (activePreview && group.some(({ item }) => item.place.id === activePreview?.place.id)) closePreview();

        const button = document.createElement("button");
        button.type = "button";
        button.className = "holy-place-cluster";
        button.dataset.mapCluster = "true";
        button.dataset.clusterCount = String(group.length);
        button.setAttribute("aria-label", `${group.length} ${clusterLabel}`);
        const count = document.createElement("span");
        count.className = "holy-place-cluster__count";
        count.textContent = String(group.length);
        count.setAttribute("aria-hidden", "true");
        button.append(count);

        const longitude = group.reduce((sum, { item }) => sum + item.place.longitude, 0) / group.length;
        const latitude = group.reduce((sum, { item }) => sum + item.place.latitude, 0) / group.length;
        button.addEventListener("click", () => {
          closePreview();
          map.easeTo({
            center: [longitude, latitude],
            zoom: getClusterExpansionZoom(group, map.getZoom(), MARKER_CLUSTER_MAX_ZOOM, MARKER_CLUSTER_RADIUS),
            duration: animationDuration(),
          });
        });
        clusterMarkers.push(
          new maplibregl.Marker({ element: button, anchor: "center" })
            .setLngLat([longitude, latitude])
            .addTo(map),
        );
      });
    };
    const fitMontenegro = (animate: boolean) => {
      map.fitBounds(MONTENEGRO_BOUNDS, {
        padding: getInitialPadding(root.clientWidth, mapLayout),
        duration: animate ? animationDuration() : 0,
        linear: true,
        maxZoom: 8,
      });
    };

    const zoomIn = () => map.zoomIn({ duration: animationDuration() });
    const zoomOut = () => map.zoomOut({ duration: animationDuration() });
    const resetView = () => {
      visitorMovedMap = false;
      fitMontenegro(true);
    };
    const markVisitorMovement = () => {
      visitorMovedMap = true;
    };
    const resizeMap = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        map.resize();
        if (!visitorMovedMap) fitMontenegro(false);
      }, 120);
    };

    const showReadyMap = () => {
      if (removed) return;
      root.dataset.mapState = "ready";
      delete root.dataset.mapLoadStatus;
      renderer.hidden = false;
      if (fallback) fallback.hidden = true;
      if (loadingSurface) loadingSurface.hidden = true;
      renderer.setAttribute("aria-hidden", "false");
      fallback?.setAttribute("aria-hidden", "true");
      loadingSurface?.setAttribute("aria-hidden", "true");
      loadingStatus?.setAttribute("aria-hidden", "true");
      if (fallbackNotice) fallbackNotice.hidden = true;
      if (attribution) attribution.hidden = false;
      setControlsEnabled(true);
      map.resize();
      fitMontenegro(false);
      updateMarkerClusters();
    };

    const showSlowLoading = () => {
      if (removed || root.dataset.mapState !== "loading") return;
      root.dataset.mapLoadStatus = "slow";
      if (loadingStatus?.dataset.mapSlowMessage) {
        loadingStatus.textContent = loadingStatus.dataset.mapSlowMessage;
      }
    };

    const setMarkerVisibility = (visibleIds: Set<string>) => {
      visibleMarkerIds = visibleIds;
      markerLinks.forEach((link) => {
        const id = link.dataset.mapMarker ?? "";
        const visible = visibleIds.has(id);
        link.hidden = !visible;
        if (!visible) {
          if (activePreview?.place.id === id) closePreview();
        }
      });
      updateMarkerClusters();
    };

    const handlePreviewEscape = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !activePreview) return;
      const marker = activePreview.link;
      closePreview();
      routePopup.remove();
      if (document.activeElement && !root.contains(document.activeElement)) marker.focus();
    };

    const handleOutsidePreviewPointer = (event: PointerEvent) => {
      if (!activePreview) return;
      const eventPath = event.composedPath();
      if (eventPath.includes(activePreview.link) || eventPath.includes(activePreview.card)) return;
      closePreview();
    };

    const handleFilterChange = ((event: CustomEvent<{ filter?: string }>) => {
      const filter = event.detail?.filter;
      if (!filter) return;
      setMarkerVisibility(new Set(markerLinks
        .filter((link) => filter === "all" || link.dataset.placeCategory === filter)
        .map((link) => link.dataset.mapMarker ?? "")));
    }) as EventListener;

    const handlePlaceVisibilityChange = ((event: CustomEvent<{ visibleIds?: string[] }>) => {
      if (!Array.isArray(event.detail?.visibleIds)) return;
      setMarkerVisibility(new Set(event.detail.visibleIds));
    }) as EventListener;

    removeActiveMap = () => {
      if (removed) return;
      removed = true;
      stopWatchingInitialLoad();
      window.clearTimeout(resizeTimer);
      closePreview();
      window.removeEventListener("resize", resizeMap);
      document.removeEventListener("keydown", handlePreviewEscape);
      document.removeEventListener("pointerdown", handleOutsidePreviewPointer);
      root.removeEventListener("pointerdown", markVisitorMovement);
      root.removeEventListener("wheel", markVisitorMovement);
      zoomInButton?.removeEventListener("click", zoomIn);
      zoomOutButton?.removeEventListener("click", zoomOut);
      resetButton?.removeEventListener("click", resetView);
      routeToggleButtons.forEach((button) => button.removeEventListener("click", handleRouteToggle));
      window.removeEventListener("svetinje:filter-change", handleFilterChange);
      window.removeEventListener("svetinje:place-visibility-change", handlePlaceVisibilityChange);
      map.off("moveend", updateMarkerClusters);
      removeClusterMarkers();
      markers.forEach((marker) => marker.remove());
      map.remove();
    };

    zoomInButton?.addEventListener("click", zoomIn);
    zoomOutButton?.addEventListener("click", zoomOut);
    resetButton?.addEventListener("click", resetView);
    routeToggleButtons.forEach((button) => button.addEventListener("click", handleRouteToggle));
    root.addEventListener("pointerdown", markVisitorMovement, { passive: true });
    root.addEventListener("wheel", markVisitorMovement, { passive: true });
    window.addEventListener("resize", resizeMap, { passive: true });
    document.addEventListener("keydown", handlePreviewEscape);
    document.addEventListener("pointerdown", handleOutsidePreviewPointer);
    window.addEventListener("svetinje:filter-change", handleFilterChange);
    window.addEventListener("svetinje:place-visibility-change", handlePlaceVisibilityChange);
    map.on("moveend", updateMarkerClusters);
    document.addEventListener("astro:before-swap", removeActiveMap, { once: true });

    // Individual tile, glyph, sprite, or terrain errors can be transient and must not destroy a recoverable map.
    stopWatchingInitialLoad = watchInitialMapLoad(map, {
      onSlow: showSlowLoading,
      onReady: showReadyMap,
      onFatal: showFallback,
      isFatalError: (event) => isFatalInitialStyleError(event, MAP_STYLE_URL),
    });
  };

  initialiseHomepageMap();
</script>
