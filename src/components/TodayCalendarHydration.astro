<script>
  import { podgoricaDateKey } from "../lib/calendar/today-calendar";

  const root = document.querySelector<HTMLElement>("[data-today-calendar]");
  if (root) {
    const year = root.dataset.calendarYear;
    const dateKey = podgoricaDateKey(new Date());
    if (year === dateKey.slice(0, 4)) {
      fetch(`/calendar/${year}.json`)
        .then((response) => response.ok ? response.json() : Promise.reject(new Error("calendar unavailable")))
        .then((payload) => {
          const day = payload.days.find((candidate: any) => candidate.date === dateKey);
          if (!day) return;
          const date = new Intl.DateTimeFormat("sr-Cyrl-ME", { timeZone: "Europe/Podgorica", day: "numeric", month: "long", year: "numeric" }).format(new Date(`${day.date}T12:00:00Z`));
          const dateNode = root.querySelector<HTMLElement>("[data-calendar-date]");
          const titleNode = root.querySelector<HTMLElement>("[data-calendar-title]");
          const weekContext = root.querySelector<HTMLElement>("[data-calendar-week-context]");
          const link = root.querySelector<HTMLAnchorElement>("[data-calendar-day-link]");
          const gospel = root.querySelector<HTMLElement>("[data-calendar-gospel]");
          if (dateNode) dateNode.textContent = date;
          if (titleNode) titleNode.textContent = day.commemoration_sr;
          if (weekContext) weekContext.textContent = day.week_context_sr;
          if (link) link.href = `/kalendar/${day.date}/`;
          if (gospel) {
            const eyebrow = Object.assign(document.createElement("p"), { className: "map-eyebrow", textContent: "ИЗ ДАНАШЊЕГ ЈЕВАНЂЕЉА" });
            const empty = Object.assign(document.createElement("p"), { textContent: "За овај дан литургијско јеванђељско читање није наведено." });
            empty.dataset.calendarEmpty = "";
            gospel.replaceChildren(eyebrow, empty);
          }
        })
        .catch(() => undefined);
    } else {
      const title = root.querySelector<HTMLElement>("[data-calendar-title]");
      const gospel = root.querySelector<HTMLElement>("[data-calendar-gospel]");
      if (title) title.textContent = "Календар за ову годину је у припреми";
      if (gospel) gospel.innerHTML = "<p>Подаци за изабрани датум још нису припремљени.</p>";
    }
  }
</script>
