---
import InterfaceIcon from "./InterfaceIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localeConfig, routeFor, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";

interface Props {
  currentPath: string;
  locale?: Locale;
  localeLinks?: Partial<Record<Locale, string>>;
}

const { currentPath, locale = "sr", localeLinks = { [locale]: currentPath } } = Astro.props;
const copy = publicCopy[locale];
const navigation = [
  { href: routeFor(locale, "monasteries"), label: copy.nav.monasteries },
  { href: routeFor(locale, "churches"), label: copy.nav.churches },
  { href: routeFor(locale, "map"), label: copy.nav.map },
  { href: routeFor(locale, "routes"), label: copy.nav.routes },
  { href: routeFor(locale, "calendar"), label: copy.nav.calendar },
  { href: routeFor(locale, "news"), label: copy.nav.news },
  { href: routeFor(locale, "about"), label: copy.nav.about },
];
const monasteryNavigation = [
  { href: routeFor(locale, "maleMonasteries"), label: copy.nav.maleMonasteries },
  { href: routeFor(locale, "femaleMonasteries"), label: copy.nav.femaleMonasteries },
];
const mobileMonasteryNavigation = [
  { href: routeFor(locale, "monasteries"), label: copy.allMonasteries },
  ...monasteryNavigation,
];

const isActive = (href: string) => !href.includes("#") && currentPath.startsWith(href);
const isExactPage = (href: string) => currentPath === href;
const monasteryRoot = routeFor(locale, "monasteries");
const calendarRoot = routeFor(locale, "calendar");
const favoritesRoot = routeFor(locale, "favorites");
const isMonasteryActive = isActive(monasteryRoot);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={routeFor(locale, "home")} aria-label={`${copy.siteName} — ${locale === "ru" ? "главная страница" : locale === "en" ? "home" : "почетна страница"}`}>
      <img
        class="brand-image"
        src="/images/brand/logo-svetinje.png"
        width="1000"
        height="321"
        alt={copy.siteName}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="primary-navigation desktop-navigation" aria-label={locale === "ru" ? "Главная навигация" : locale === "en" ? "Primary navigation" : "Главна навигација"}>
      <ul>
        {navigation.map((item) => item.href === monasteryRoot ? (
          <li class="desktop-navigation__submenu-item">
            <a
              href={item.href}
              aria-current={isExactPage(item.href) ? "page" : undefined}
              data-section-active={isMonasteryActive ? "true" : undefined}
            >
              {item.label}
            </a>
            <div class="desktop-navigation__submenu">
              <ul aria-label={copy.nav.monasteries}>
                {monasteryNavigation.map((subcategory) => (
                  <li>
                    <a href={subcategory.href} aria-current={isExactPage(subcategory.href) ? "page" : undefined}>
                      {subcategory.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              data-calendar-today-link={locale === "sr" && item.href === calendarRoot ? "true" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools desktop-tools">
      <a class="favourites-control" href={favoritesRoot} aria-label={`${copy.favorites.collectionLabel}: 0`} data-favorites-link data-favorites-label={copy.favorites.collectionLabel} aria-current={isActive(favoritesRoot) ? "page" : undefined}>
        <InterfaceIcon name="heart" size={21} />
        <span data-favorites-count aria-hidden="true">0</span>
      </a>
      <details class="header-language">
        <summary>{localeConfig[locale].label} <InterfaceIcon name="chevron" size={15} /></summary>
        <div class="header-language__panel"><LanguageSwitcher currentLocale={locale} destinations={localeLinks} /></div>
      </details>
    </div>

    <details class="mobile-navigation">
      <summary aria-label={copy.openMenu}>
        <span>{copy.menu}</span>
        <i aria-hidden="true"></i>
      </summary>
      <div class="mobile-navigation-panel">
        <nav aria-label={locale === "ru" ? "Главная мобильная навигация" : locale === "en" ? "Primary mobile navigation" : "Главна мобилна навигација"}>
          <ul>
            {navigation.map((item) => item.href === monasteryRoot ? (
              <li>
                <details class="mobile-navigation__submenu" open={isMonasteryActive}>
                  <summary data-section-active={isMonasteryActive ? "true" : undefined}>{copy.nav.monasteries}</summary>
                  <ul aria-label={copy.nav.monasteries}>
                    {mobileMonasteryNavigation.map((subcategory) => (
                      <li>
                        <a href={subcategory.href} aria-current={isExactPage(subcategory.href) ? "page" : undefined}>
                          {subcategory.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  data-calendar-today-link={locale === "sr" && item.href === calendarRoot ? "true" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="mobile-tool-row mobile-tool-row--single">
          <a href={favoritesRoot} aria-label={`${copy.favorites.collectionLabel}: 0`} data-favorites-link data-favorites-label={copy.favorites.collectionLabel} aria-current={isActive(favoritesRoot) ? "page" : undefined}>
            <InterfaceIcon name="heart" size={19} /> {copy.favorites.label} <span data-favorites-count>0</span>
          </a>
        </div>
        <LanguageSwitcher currentLocale={locale} destinations={localeLinks} />
      </div>
    </details>
  </div>
</header>

<script>
  import { calendarNavigationHref } from "../lib/calendar/today-calendar";
  import { getFavoriteIds, subscribeFavorites } from "../lib/favorites";

  type FavoritesHeaderWindow = Window & { __svetinjeFavoritesHeaderCleanup?: () => void };

  const initialiseFavoritesHeader = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    if (!header || header.dataset.favoritesInitialised === "true") return;
    header.dataset.favoritesInitialised = "true";
    const counts = [...header.querySelectorAll<HTMLElement>("[data-favorites-count]")];
    const links = [...header.querySelectorAll<HTMLAnchorElement>("[data-favorites-link]")];
    const render = (ids: string[]) => {
      counts.forEach((count) => { count.textContent = String(ids.length); });
      links.forEach((link) => { link.setAttribute("aria-label", `${link.dataset.favoritesLabel}: ${ids.length}`); });
    };
    render(getFavoriteIds());

    const favoritesWindow = window as FavoritesHeaderWindow;
    favoritesWindow.__svetinjeFavoritesHeaderCleanup?.();
    favoritesWindow.__svetinjeFavoritesHeaderCleanup = subscribeFavorites(render);
  };

  initialiseFavoritesHeader();
  document.addEventListener("astro:page-load", initialiseFavoritesHeader);

  document.querySelectorAll<HTMLAnchorElement>("[data-calendar-today-link]").forEach((link) => {
    const updateDestination = () => {
      link.href = calendarNavigationHref(new Date());
    };
    updateDestination();
    link.addEventListener("click", updateDestination);
  });
</script>

<style>
  .favourites-control {
    cursor: pointer;
    text-decoration: none;
  }

  .favourites-control:hover,
  .favourites-control[aria-current="page"] {
    color: var(--gold-deep);
  }

  .favourites-control:focus-visible,
  .mobile-tool-row a[href][aria-label]:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
</style>
