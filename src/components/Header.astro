---
import InterfaceIcon from "./InterfaceIcon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigation = [
  { href: "/manastiri/", label: "Манастири" },
  { href: "/crkve/", label: "Цркве" },
  { href: "/mapa/", label: "Мапа" },
  { href: "/rute/", label: "Руте" },
  { href: "/o-projektu/", label: "О пројекту" },
];

const isActive = (href: string) => !href.includes("#") && currentPath.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Светиње — почетна страница">
      <img
        class="brand-image"
        src="/images/brand/logo-svetinje.png"
        width="1000"
        height="321"
        alt="Светиње"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="primary-navigation desktop-navigation" aria-label="Главна навигација">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools desktop-tools">
      <button class="favourites-control" type="button" disabled aria-label="Омиљене светиње — 0, функција је у припреми">
        <InterfaceIcon name="heart" size={21} />
        <span aria-hidden="true">0</span>
      </button>
      <details class="header-language">
        <summary>Српски <InterfaceIcon name="chevron" size={15} /></summary>
        <div class="header-language__panel"><LanguageSwitcher currentLocale="sr" /></div>
      </details>
    </div>

    <details class="mobile-navigation">
      <summary aria-label="Отвори главни мени">
        <span>Мени</span>
        <i aria-hidden="true"></i>
      </summary>
      <div class="mobile-navigation-panel">
        <nav aria-label="Главна мобилна навигација">
          <ul>
            {navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="mobile-tool-row mobile-tool-row--single">
          <span><InterfaceIcon name="heart" size={19} /> Омиљено 0</span>
        </div>
        <LanguageSwitcher currentLocale="sr" />
      </div>
    </details>
  </div>
</header>
