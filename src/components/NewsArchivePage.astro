---
import type { Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
import type { VisibleNewsItem } from "../lib/content/news";
import { NEWS_TYPES, newsDateParts } from "../lib/news-types";
import { NEWS_PER_PAGE, pageCountForNews } from "../lib/news-archive-state";
import NewsFeed from "./news/NewsFeed.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { routeFor } from "../i18n/config";

interface Props { items: VisibleNewsItem[]; locale?: Locale; metadataDescription?: string | undefined }
const { items, locale = "sr", metadataDescription } = Astro.props;
const copy = publicCopy[locale].pages.news;
const categories = NEWS_TYPES
  .map((type) => ({ type, label: copy.types[type], count: items.filter((item) => item.type === type).length }))
  .filter((category) => category.count > 0);
const archiveByKey = new Map<string, { key: string; label: string; count: number }>();
for (const item of items) {
  const date = newsDateParts(item.publishedAt, locale);
  const existing = archiveByKey.get(date.archiveKey);
  archiveByKey.set(date.archiveKey, { key: date.archiveKey, label: date.archiveLabel, count: (existing?.count ?? 0) + 1 });
}
const archiveGroups = [...archiveByKey.values()].sort((left, right) => right.key.localeCompare(left.key));
const hasCategoryFilters = categories.length >= 2;
const hasArchiveFilters = archiveGroups.length >= 2;
const hasFilters = hasCategoryFilters || hasArchiveFilters;
const totalPages = pageCountForNews(items.length);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
const runtimeCopy = JSON.stringify({ shown: copy.shown, empty: copy.empty, pageOf: copy.pageOf }).replaceAll("<", "\\u003c");
const shownText = copy.shown.replace("{count}", String(items.length));
---

<BaseLayout title={copy.title} description={metadataDescription ?? copy.description} canonicalPath={routeFor(locale, "news")} locale={locale}>
<div class="news-archive-page" data-news-archive data-testid="news-archive-page" data-news-locale={locale}>
  <header class="news-archive-heading">
    <div class="shell"><h1>{copy.title}</h1><p>{copy.description}</p></div>
  </header>

  <section class="news-archive" aria-label={copy.allNews}>
    {hasFilters && <div class="shell news-mobile-filter">
      <button type="button" data-news-filter-toggle aria-expanded="false" aria-controls="news-filters">
        <span>{copy.filters}</span><strong data-news-mobile-filter-count hidden></strong>
      </button>
    </div>}
    <div class:list={["shell", "news-archive__layout", { "news-archive__layout--with-filters": hasFilters }]}>
      <div class="news-archive__main">
        <p class="news-filter-status" role="status" aria-live="polite" data-news-filter-status>{shownText}</p>
        <div id="news-archive-feed"><NewsFeed items={items} variant="archive" emptyText={copy.empty} initialVisibleCount={NEWS_PER_PAGE} /></div>
        <p class="news-filter-empty" role="status" data-news-filter-empty hidden>{copy.empty}</p>
        <nav class="explorer-pagination news-pagination" aria-label={copy.paginationAria} data-news-pagination data-total-pages={totalPages} hidden={totalPages <= 1}>
          <button class="explorer-pagination__arrow" type="button" data-news-pagination-previous aria-label={copy.previous} disabled><span aria-hidden="true">←</span></button>
          <div class="explorer-pagination__pages" data-news-pagination-pages>
            {pageNumbers.map((page) => <button type="button" data-news-pagination-page={page} aria-label={`${copy.page} ${page}`} aria-current={page === 1 ? "page" : undefined}>{page}</button>)}
          </div>
          <button class="explorer-pagination__arrow" type="button" data-news-pagination-next aria-label={copy.next}><span aria-hidden="true">→</span></button>
          <p class="explorer-pagination__status" data-news-pagination-status aria-live="polite">{copy.pageOf.replace("{current}", "1").replace("{total}", String(totalPages))}</p>
        </nav>
      </div>

      {hasFilters && <aside id="news-filters" class="news-sidebar" aria-label={copy.filters}>
        {hasCategoryFilters && <section class="news-sidebar-panel" aria-labelledby="news-categories-title">
          <h2 id="news-categories-title">{copy.categories}</h2>
          <div class="news-filter-list">
            <button type="button" data-news-category="all" aria-pressed="true" aria-controls="news-archive-feed"><span>{copy.allCategories}</span><strong>{items.length}</strong></button>
            {categories.map((category) => <button type="button" data-news-category={category.type} aria-pressed="false" aria-controls="news-archive-feed"><span>{category.label}</span><strong>{category.count}</strong></button>)}
          </div>
        </section>}

        {hasArchiveFilters && <section class="news-sidebar-panel" aria-labelledby="news-archive-title">
          <h2 id="news-archive-title">{copy.archive}</h2>
          <div class="news-filter-list news-filter-list--archive">
            <button type="button" data-news-month="all" aria-pressed="true" aria-controls="news-archive-feed"><span>{copy.allPeriods}</span><strong>{items.length}</strong></button>
            {archiveGroups.map((group) => <button type="button" data-news-month={group.key} aria-pressed="false" aria-controls="news-archive-feed"><span>{group.label}</span><strong>{group.count}</strong></button>)}
          </div>
        </section>}
        <button class="news-filter-reset" type="button" data-news-reset>{copy.reset} <span aria-hidden="true">↺</span></button>
      </aside>}
    </div>
  </section>
  <script type="application/json" data-news-copy set:html={runtimeCopy} is:inline />
</div>
</BaseLayout>

<script>
  import { NEWS_PER_PAGE, pageCountForNews } from "../lib/news-archive-state";

  document.querySelectorAll<HTMLElement>("[data-news-archive]").forEach((archive) => {
    const copyElement = archive.querySelector<HTMLScriptElement>("[data-news-copy]");
    const copy = JSON.parse(copyElement?.textContent ?? "{}") as { shown: string; empty: string; pageOf: string };
    const items = [...archive.querySelectorAll<HTMLElement>("[data-news-item]")];
    const categoryButtons = [...archive.querySelectorAll<HTMLButtonElement>("[data-news-category]")];
    const monthButtons = [...archive.querySelectorAll<HTMLButtonElement>("[data-news-month]")];
    const resetButton = archive.querySelector<HTMLButtonElement>("[data-news-reset]");
    const filterToggle = archive.querySelector<HTMLButtonElement>("[data-news-filter-toggle]");
    const mobileFilterCount = archive.querySelector<HTMLElement>("[data-news-mobile-filter-count]");
    const status = archive.querySelector<HTMLElement>("[data-news-filter-status]");
    const empty = archive.querySelector<HTMLElement>("[data-news-filter-empty]");
    const pagination = archive.querySelector<HTMLElement>("[data-news-pagination]");
    const previousButton = archive.querySelector<HTMLButtonElement>("[data-news-pagination-previous]");
    const nextButton = archive.querySelector<HTMLButtonElement>("[data-news-pagination-next]");
    const pageButtons = [...archive.querySelectorAll<HTMLButtonElement>("[data-news-pagination-page]")];
    const paginationStatus = archive.querySelector<HTMLElement>("[data-news-pagination-status]");
    let selectedCategory = "all";
    let selectedMonth = "all";
    let currentPage = 1;
    const setPressed = (buttons: HTMLButtonElement[], value: string, dataKey: "newsCategory" | "newsMonth") => {
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset[dataKey] === value));
    };
    const updateMobileFilterCount = () => {
      const activeCount = Number(categoryButtons.length > 0 && selectedCategory !== "all") + Number(monthButtons.length > 0 && selectedMonth !== "all");
      if (mobileFilterCount) {
        mobileFilterCount.textContent = String(activeCount);
        mobileFilterCount.hidden = activeCount === 0;
      }
    };
    const renderPage = (requestedPage: number, matchedItems: HTMLElement[]) => {
      const totalPages = pageCountForNews(matchedItems.length);
      currentPage = totalPages === 0 ? 1 : Math.min(Math.max(1, requestedPage), totalPages);
      const pageStart = (currentPage - 1) * NEWS_PER_PAGE;
      items.forEach((item) => { item.hidden = true; });
      matchedItems.forEach((item, index) => { item.hidden = index < pageStart || index >= pageStart + NEWS_PER_PAGE; });
      if (previousButton) previousButton.disabled = totalPages === 0 || currentPage === 1;
      if (nextButton) nextButton.disabled = totalPages === 0 || currentPage === totalPages;
      pageButtons.forEach((button) => {
        const page = Number(button.dataset.newsPaginationPage);
        button.hidden = page > totalPages;
        if (page === currentPage) button.setAttribute("aria-current", "page");
        else button.removeAttribute("aria-current");
      });
      if (pagination) pagination.hidden = totalPages <= 1;
      if (paginationStatus && totalPages > 0) paginationStatus.textContent = copy.pageOf.replace("{current}", String(currentPage)).replace("{total}", String(totalPages));
    };
    const applyFilters = (requestedPage = 1) => {
      const matchedItems = items.filter((item) => (
        (selectedCategory === "all" || item.dataset.newsType === selectedCategory)
        && (selectedMonth === "all" || item.dataset.newsMonth === selectedMonth)
      ));
      if (status) status.textContent = copy.shown.replace("{count}", String(matchedItems.length));
      if (empty) empty.hidden = matchedItems.length !== 0;
      updateMobileFilterCount();
      renderPage(requestedPage, matchedItems);
    };
    for (const button of categoryButtons) button.addEventListener("click", () => { selectedCategory = button.dataset.newsCategory ?? "all"; setPressed(categoryButtons, selectedCategory, "newsCategory"); applyFilters(1); });
    for (const button of monthButtons) button.addEventListener("click", () => { selectedMonth = button.dataset.newsMonth ?? "all"; setPressed(monthButtons, selectedMonth, "newsMonth"); applyFilters(1); });
    resetButton?.addEventListener("click", () => { selectedCategory = "all"; selectedMonth = "all"; setPressed(categoryButtons, selectedCategory, "newsCategory"); setPressed(monthButtons, selectedMonth, "newsMonth"); applyFilters(1); });
    previousButton?.addEventListener("click", () => applyFilters(currentPage - 1));
    nextButton?.addEventListener("click", () => applyFilters(currentPage + 1));
    for (const button of pageButtons) button.addEventListener("click", () => applyFilters(Number(button.dataset.newsPaginationPage)));
    filterToggle?.addEventListener("click", () => {
      const open = archive.dataset.mobileFiltersOpen !== "true";
      archive.dataset.mobileFiltersOpen = String(open);
      filterToggle.setAttribute("aria-expanded", String(open));
    });
    applyFilters(1);
  });
</script>
