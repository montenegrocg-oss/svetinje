---
import InterfaceIcon from "./InterfaceIcon.astro";
import RouteCard from "./routes/RouteCard.astro";
import type { VisibleRoute } from "../lib/content/routes";
import { routeFor, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";

interface Props { routes: VisibleRoute[]; locale?: Locale }
const { routes, locale = "sr" } = Astro.props;
const copy = publicCopy[locale].homepage.routes;
const featuredRoutes = locale === "sr" ? routes.filter((route) => route.featured.enabled).sort((left, right) => left.featured.order - right.featured.order).slice(0, 3) : [];
---

<section
  class="popular-routes map-explorer__routes"
  id="rute"
  aria-labelledby="routes-title"
  data-testid="popular-routes"
>
  <div class="popular-routes__inner">
    <header class="shelf-heading">
      <h2 id="routes-title">{copy.title}</h2>
      {featuredRoutes.length ? <a href={routeFor(locale, "routes")}>{copy.showAll}</a> : <span aria-disabled="true">{copy.showAll}</span>}
    </header>
    {featuredRoutes.length ? <div class="popular-routes__cards">{featuredRoutes.map((route) => <RouteCard route={route} compact />)}</div> : <article class="route-placeholder">
      <div class="route-placeholder__visual" aria-hidden="true">
        <span></span><i></i><i></i><i></i>
      </div>
      <div>
        <p class="placeholder-label">{copy.preparingLabel}</p>
        <h3>{copy.preparingTitle}</h3>
        <p>{copy.preparingBody}</p>
      </div>
      <InterfaceIcon name="route" size={22} />
    </article>}
  </div>
</section>
