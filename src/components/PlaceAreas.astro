---
import { PLACE_AREAS } from "../lib/place-areas";
import type { VisiblePlace } from "../lib/content/publication";

interface Props {
  places: VisiblePlace[];
}

const { places } = Astro.props;
const areas = PLACE_AREAS.map((area) => ({
  ...area,
  count: places.filter((place) => place.browseAreaId === area.id).length,
}));
---

<section class="homepage-areas" aria-labelledby="homepage-areas-title">
  <div class="shell homepage-wide-shell homepage-areas__inner">
    <header class="homepage-areas__header">
      <p class="map-eyebrow">ИСТРАЖИТЕ</p>
      <h2 id="homepage-areas-title">По областима</h2>
      <p>Откријте манастире, храмове и света мјеста у различитим крајевима Црне Горе.</p>
    </header>
    <ul class="homepage-areas__list">
      {areas.map((area) => (
        <li>
          <a href={`/?area=${area.id}#mapa`} data-place-area-link={area.id}>
            <span>{area.label}</span>
            {area.count > 0 && (
              <span class="homepage-areas__count" data-place-area-count={area.count}>
                {area.count}
              </span>
            )}
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
