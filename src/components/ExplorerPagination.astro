---
import { pageCountForPlaces } from "../lib/explorer-pagination";

interface Props {
  totalPlaces: number;
  locale?: import("../i18n/config").Locale;
}

import { publicCopy } from "../i18n/public-copy";
const { totalPlaces, locale = "sr" } = Astro.props;
const copy = publicCopy[locale];
const totalPages = pageCountForPlaces(totalPlaces);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

<nav
  class="explorer-pagination catalogue-pagination"
  aria-label={locale === "ru" ? "Страницы результатов" : locale === "en" ? "Result pages" : "Странице резултата"}
  data-catalogue-pagination
  data-total-pages={totalPages}
  hidden={totalPages <= 1}
>
  <button
    class="explorer-pagination__arrow"
    type="button"
    data-pagination-previous
    aria-label={copy.homepage.explorer.pagination.previous}
    disabled
  >
    <span aria-hidden="true">←</span>
  </button>
  <div class="explorer-pagination__pages" data-pagination-pages>
    {pageNumbers.map((page) => (
      <button
        type="button"
        data-pagination-page={page}
        aria-label={`${copy.page} ${page}`}
        aria-current={page === 1 ? "page" : undefined}
      >
        {page}
      </button>
    ))}
  </div>
  <button
    class="explorer-pagination__arrow"
    type="button"
    data-pagination-next
    aria-label={copy.homepage.explorer.pagination.next}
  >
    <span aria-hidden="true">→</span>
  </button>
  <p class="explorer-pagination__status" data-pagination-status aria-live="polite">
    {copy.page} 1 {copy.of} {totalPages}
  </p>
</nav>
