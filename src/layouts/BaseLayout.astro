---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageMetadata from "../components/PageMetadata.astro";
import { localeConfig, staticEquivalentForPath, type Locale } from "../i18n/config";
import { publicCopy } from "../i18n/public-copy";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  locale?: Locale;
  localeLinks?: Partial<Record<Locale, string>>;
}

const { title, description, canonicalPath, noindex = false, locale = "sr", localeLinks: suppliedLocaleLinks } = Astro.props;
const editorialPreview = process.env.EDITORIAL_PREVIEW === "true";
const localeLinks = suppliedLocaleLinks ?? staticEquivalentForPath(canonicalPath) ?? { [locale]: canonicalPath };
const copy = publicCopy[locale];
---

<!doctype html>
<html lang={localeConfig[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#172822" />
    <PageMetadata
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex || editorialPreview}
      locale={locale}
      localeLinks={localeLinks}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header currentPath={Astro.url.pathname} locale={locale} localeLinks={localeLinks} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
