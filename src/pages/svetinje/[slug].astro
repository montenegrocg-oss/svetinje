---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceDetailGallery from "../../components/place-detail/PlaceDetailGallery.astro";
import PlaceDetailHero from "../../components/place-detail/PlaceDetailHero.astro";
import PlacePracticalPanel from "../../components/place-detail/PlacePracticalPanel.astro";
import PlaceRelatedShelf from "../../components/place-detail/PlaceRelatedShelf.astro";
import type { VisiblePlace } from "../../lib/content/publication";
import { loadVisiblePlaces } from "../../lib/content/publication";

interface RelatedPlace {
  place: VisiblePlace;
  distanceKm: number | undefined;
}

export async function getStaticPaths() {
  const EARTH_RADIUS_KM = 6371;
  const toRadians = (degrees: number) => degrees * Math.PI / 180;
  const coordinateDistance = (from: VisiblePlace, to: VisiblePlace): number | undefined => {
    if (
      from.latitude === undefined || from.longitude === undefined ||
      to.latitude === undefined || to.longitude === undefined
    ) return undefined;
    const latitudeDelta = toRadians(to.latitude - from.latitude);
    const longitudeDelta = toRadians(to.longitude - from.longitude);
    const fromLatitude = toRadians(from.latitude);
    const toLatitude = toRadians(to.latitude);
    const haversine = Math.sin(latitudeDelta / 2) ** 2
      + Math.cos(fromLatitude) * Math.cos(toLatitude) * Math.sin(longitudeDelta / 2) ** 2;
    return 2 * EARTH_RADIUS_KM * Math.asin(Math.sqrt(haversine));
  };
  const relatedPlacesFor = (place: VisiblePlace, places: VisiblePlace[]): RelatedPlace[] =>
    places
      .filter((candidate) => candidate.id !== place.id)
      .map((candidate) => ({
        place: candidate,
        distanceKm: coordinateDistance(place, candidate),
        hasCoordinates: candidate.latitude !== undefined && candidate.longitude !== undefined,
      }))
      .sort((left, right) => {
        if (left.distanceKm !== undefined && right.distanceKm !== undefined) return left.distanceKm - right.distanceKm;
        if (left.distanceKm !== undefined) return -1;
        if (right.distanceKm !== undefined) return 1;
        if (left.hasCoordinates !== right.hasCoordinates) return left.hasCoordinates ? -1 : 1;
        return left.place.name.localeCompare(right.place.name, "sr");
      })
      .map(({ place: candidate, distanceKm }) => ({ place: candidate, distanceKm }))
      .slice(0, 4);
  const places = await loadVisiblePlaces();
  return places.map((place) => ({
    params: { slug: place.slug },
    props: { place, relatedPlaces: relatedPlacesFor(place, places) },
  }));
}

const { place, relatedPlaces } = Astro.props as { place: VisiblePlace; relatedPlaces: RelatedPlace[] };
const [introSection, ...remainingNarrativeSections] = place.narrativeSections;
---

<BaseLayout
  title={place.name}
  description={place.summary}
  canonicalPath={`/svetinje/${place.slug}/`}
  noindex={place.preview}
>
  <PlaceDetailHero place={place} />

  <section class="place-profile-body">
    <div class="shell place-profile-grid">
      <article class="place-profile-about prose" aria-labelledby="place-about-title">
        <p class="eyebrow">Уређивачки преглед</p>
        <h2 id="place-about-title">О светињи</h2>
        {introSection ? (
          <section aria-labelledby={`narrative-${introSection.id}`}>
            <h3 id={`narrative-${introSection.id}`} class="place-profile-about__original-title">{introSection.title}</h3>
            {introSection.paragraphs.map((paragraph) => (
              <p>
                {paragraph.text}
                {paragraph.sourceIds.map((sourceId, index) => (
                  <sup><a href={`#source-${sourceId}`} aria-label={`Извор ${index + 1} за овај навод`}>[{index + 1}]</a></sup>
                ))}
              </p>
            ))}
          </section>
        ) : (
          <p>Уређивачки текст је у припреми.</p>
        )}
      </article>

      <PlaceDetailGallery place={place} />
      <PlacePracticalPanel place={place} />

      <div class="place-profile-cards">
        {remainingNarrativeSections.map((section) => (
          <section class="place-editorial-card prose" aria-labelledby={`narrative-${section.id}`}>
            <h2 id={`narrative-${section.id}`}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>
                {paragraph.text}
                {paragraph.sourceIds.map((sourceId, index) => (
                  <sup><a href={`#source-${sourceId}`} aria-label={`Извор ${index + 1} за овај навод`}>[{index + 1}]</a></sup>
                ))}
              </p>
            ))}
          </section>
        ))}

        <section class="place-editorial-card place-arrival-card" aria-labelledby="place-arrival-title">
          <h2 id="place-arrival-title">Како стићи</h2>
          {place.address && <p><strong>Адреса:</strong> {place.address}</p>}
          <p>Локација је означена на главној карти. Прије посјете провјерите приступ и услове на терену.</p>
          <a class="place-inline-link" href="/#mapa">Прикажи на главној карти <span aria-hidden="true">→</span></a>
        </section>
      </div>

      <PlaceRelatedShelf currentPlace={place} relatedPlaces={relatedPlaces} />

      <section class="place-profile-sources" aria-labelledby="place-sources-title">
        <div class="place-section-heading">
          <p class="eyebrow">Траг извора</p>
          <h2 id="place-sources-title">Извори и напомене</h2>
        </div>
        <ol>
          {place.sources.map((source) => (
            <li id={`source-${source.id}`}><span>{source.title}</span><code>{source.id}</code></li>
          ))}
        </ol>
      </section>
    </div>
  </section>
</BaseLayout>
