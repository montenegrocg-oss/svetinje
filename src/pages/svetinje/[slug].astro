---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { VisiblePlace } from "../../lib/content/publication";
import { loadVisiblePlaces } from "../../lib/content/publication";

export async function getStaticPaths() {
  const places = await loadVisiblePlaces();
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

const { place } = Astro.props as { place: VisiblePlace };
const location = [place.settlement, place.municipality].filter(Boolean).join(", ");
---

<BaseLayout
  title={place.name}
  description={place.summary}
  canonicalPath={`/svetinje/${place.slug}/`}
  noindex={place.preview}
>
  <header class="place-detail-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Путања странице">
        <a href="/">Почетна</a><span aria-hidden="true">/</span>
        <a href="/svetinje/">Светиње</a><span aria-hidden="true">/</span>
        <span aria-current="page">{place.name}</span>
      </nav>

      <div class="place-detail-hero__grid">
        <div class="place-detail-hero__copy">
          {place.preview && <p class="preview-notice">Радни приказ · садржај провјерава уредник пројекта</p>}
          <p class="eyebrow">{place.typeLabel}</p>
          <h1>{place.name}</h1>
          <p class="place-detail-summary">{place.summary}</p>
        </div>
        <div class="place-media-placeholder" role="img" aria-label="Фотографија још није додата">
          <span aria-hidden="true"></span>
          <p>Ауторска фотографија биће додата</p>
        </div>
      </div>
    </div>
  </header>

  <section class="place-detail-body section">
    <div class="shell place-detail-layout">
      <aside class="place-facts" aria-labelledby="place-facts-title">
        <p class="eyebrow" id="place-facts-title">Основни подаци</p>
        <dl>
          <div><dt>Тип</dt><dd>{place.typeLabel}</dd></div>
          <div><dt>Мјесто</dt><dd>{location}</dd></div>
          <div><dt>Адреса</dt><dd>{place.address}</dd></div>
          <div><dt>Црквена припадност</dt><dd>{place.ecclesiasticalJurisdiction}</dd></div>
        </dl>
        <p class="fact-qualification">Подаци су у радном статусу и захтијевају стручну провјеру прије јавне објаве.</p>
      </aside>

      <article class="place-narrative prose" aria-label={`Историја и идентитет — ${place.name}`}>
        {place.narrativeSections.map((section) => (
          <section aria-labelledby={`narrative-${section.id}`}>
            <h2 id={`narrative-${section.id}`}>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>
                {paragraph.text}
                {paragraph.sourceIds.map((sourceId, index) => (
                  <sup><a href={`#source-${sourceId}`} aria-label={`Извор ${index + 1} за овај навод`}>[{index + 1}]</a></sup>
                ))}
              </p>
            ))}
          </section>
        ))}
      </article>
    </div>
  </section>

  {place.latitude !== undefined && place.longitude !== undefined ? (
  <section class="place-location-band" aria-labelledby="place-location-title">
    <div class="shell place-location-band__grid">
      <div>
        <p class="eyebrow">Положај</p>
        <h2 id="place-location-title">Положај светиње</h2>
        <p>Координате означавају центроид комплекса, а не тачан пјешачки улаз.</p>
      </div>
      <div class="coordinate-block">
        <span>{place.latitude?.toFixed(5)}, {place.longitude?.toFixed(5)}</span>
        <small>EPSG:4326 · тачност: центроид комплекса</small>
        <a class="button-link" href="/#mapa">Прикажи на главној карти</a>
      </div>
    </div>
  </section>
  ) : (
    <section class="place-location-band" aria-labelledby="place-location-title">
      <div class="shell place-location-band__grid">
        <div>
          <p class="eyebrow">Положај</p>
          <h2 id="place-location-title">Географска провјера у току</h2>
          <p>Тачна локација на мапи биће додата након географске провјере.</p>
        </div>
      </div>
    </section>
  )}

  <section class="section place-sources" aria-labelledby="place-sources-title">
    <div class="shell narrow">
      <p class="eyebrow">Траг извора</p>
      <h2 id="place-sources-title">Регистровани извори</h2>
      <ol>
        {place.sources.map((source) => (
          <li id={`source-${source.id}`}><span>{source.title}</span><code>{source.id}</code></li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
