---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PlaceCard from "../../../components/PlaceCard.astro";
import ElevationProfile from "../../../components/routes/ElevationProfile.astro";
import RouteMap from "../../../components/routes/RouteMap.astro";
import { loadVisibleRoutes, type VisibleRoute } from "../../../lib/content/routes";

export async function getStaticPaths() {
  return (await loadVisibleRoutes()).map((route) => ({ params: { slug: route.slug }, props: { route } }));
}

const { route } = Astro.props as { route: VisibleRoute };
const duration = route.metrics.estimated_duration_minutes ?? route.metrics.recorded_duration_minutes;
const durationText = duration === undefined ? undefined : `${Math.floor(duration / 60)} ч ${duration % 60 ? `${duration % 60} мин` : ""}`.trim();
const isOneWay = route.direction === "one-way";
const durationNote = isOneWay && route.metrics.estimated_duration_minutes !== undefined
  ? "Процијењено вријеме односи се на кретање у једном смјеру."
  : isOneWay && route.metrics.recorded_duration_minutes !== undefined
    ? "Забиљежено вријеме односи се на ову једносмјерну трасу; повратак није урачунат."
    : undefined;
const difficulty = { easy: "Лака", moderate: "Средње захтјевна", demanding: "Захтјевна" }[route.difficulty];
const direction = { "one-way": "Једносмјерна", "out-and-back": "Повратна", circular: "Кружна" }[route.direction];
const surfaces: Record<string, string> = { paved: "Асфалт", gravel: "Макадам", trail: "Стаза", rock: "Камен", steps: "Степенице", other: "Остало" };
const seasons: Record<string, string> = { spring: "Прољеће", summer: "Љето", autumn: "Јесен", winter: "Зима" };
const parking = { unknown: "Није провјерено", available: "Доступан", limited: "Ограничен", none: "Нема паркинга" };
const trailMarking = { unknown: "Није провјерено", marked: "Маркирана", "partially-marked": "Дјелимично маркирана", unmarked: "Није маркирана" };
const difficultSections = { unknown: "Није провјерено", none: "Нема посебно захтјевних дјелова", present: "Постоје захтјевни дјелови" };
const mobileSignal = { unknown: "Није провјерено", good: "Добар", variable: "Промјенљив", poor: "Слаб", none: "Нема сигнала" };
const water = route.water.status === "unknown" ? "Није провјерено"
  : route.water.status === "none" ? "Нема провјереног извора воде"
    : route.water.status === "available" ? (route.water.note ?? "Доступна")
      : (route.water.note ?? "Захтијева провјеру");
const practical = route.practical;
const routeDetails = [
  { label: "Полазна тачка", value: route.startPlace.name },
  { label: "Крајња тачка", value: route.endPlace.name },
  { label: "Тип руте", value: direction },
  route.recommendedSeasons.length > 0 ? { label: "Најбоље вријеме за посјету", value: route.recommendedSeasons.map((item) => seasons[item] ?? item).join(", ") } : undefined,
  practical?.footwear?.recommendation ? { label: "Препоручена опрема", value: practical.footwear.recommendation } : undefined,
].filter((row): row is { label: string; value: string } => Boolean(row));
const practicalRows = [
  practical?.start_access?.note ? { label: "Приступ полазишту", value: practical.start_access.note } : undefined,
  { label: "Паркинг", value: parking[practical?.parking?.status ?? "unknown"], note: practical?.parking?.note },
  { label: "Означеност", value: trailMarking[practical?.trail_marking?.status ?? "unknown"], note: practical?.trail_marking?.note },
  route.surface.length > 0 ? { label: "Површина пута", value: route.surface.map((item) => surfaces[item] ?? item).join(", ") } : undefined,
  { label: "Захтјевни дјелови", value: difficultSections[practical?.difficult_sections?.status ?? "unknown"], note: practical?.difficult_sections?.note },
  { label: "Вода", value: water },
  { label: "Мобилни сигнал", value: mobileSignal[practical?.mobile_signal?.status ?? "unknown"], note: practical?.mobile_signal?.note },
  practical?.weather?.note ? { label: "Вријеме и вјетар", value: practical.weather.note } : undefined,
].filter((row): row is { label: string; value: string; note?: string } => Boolean(row));
const [aboutSection, ...remainingNarrativeSections] = route.narrativeSections;
const aboutParagraphs = aboutSection?.paragraphs.map((paragraph) => paragraph.text) ?? [route.summary];
const metricRows = [
  { label: "Удаљеност", value: `${(route.metrics.distance_m! / 1000).toLocaleString("sr-ME", { maximumFractionDigits: 1 })} km` },
  route.metrics.ascent_m === undefined ? undefined : { label: "Укупни успон", value: `${route.metrics.ascent_m.toLocaleString("sr-ME")} m` },
  durationText ? { label: "Вријеме хода", value: durationText } : undefined,
  { label: "Тежина", value: difficulty },
].filter((row): row is { label: string; value: string } => Boolean(row));
---

<BaseLayout title={route.name} description={route.summary} canonicalPath={`/rute/${route.slug}/`} noindex={route.preview}>
  <main class="route-detail-page">
    <div class="shell route-detail-toolbar">
      <a class="route-back-link" href="/rute/"><span aria-hidden="true">←</span> Назад на све руте</a>
      <div class="route-detail-toolbar__actions">
        <a class="route-download" href={route.gpxUrl} download>Преузми GPX</a>
        <button class="route-share" type="button" data-route-share><span aria-hidden="true">↗</span> Подијели руту</button>
        <span class="visually-hidden" role="status" aria-live="polite" data-route-share-status></span>
      </div>
    </div>

    <article class="shell route-overview">
      <header class="route-overview__identity">
        <p class="route-type-chip">Пјешачка рута</p>
        <h1>{route.name}</h1>
        <p class="route-overview__lead">{route.summary}</p>
        <dl class="route-overview__metrics">
          {metricRows.map((row) => <div><dt class="route-stat__label">{row.label}</dt><dd class="route-stat__value">{row.value}</dd></div>)}
        </dl>
        {isOneWay && <div class="route-direction"><strong>Једносмјерна рута</strong>{durationNote && <p>{durationNote}</p>}</div>}
      </header>
      <RouteMap route={route} />
      <section class="route-about" aria-labelledby="route-about-title">
        <p class="route-section-eyebrow">О рути</p>
        <h2 class="route-card-title" id="route-about-title">О рути</h2>
        {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    </article>

    <div class="shell route-guide">
      <section class="route-details-card" aria-labelledby="route-details-title">
        <header class="route-section-header">
          <p class="route-section-eyebrow">Детаљи</p>
          <h2 class="route-section-title" id="route-details-title">Детаљи руте</h2>
        </header>
        <dl>{routeDetails.map((row, index) => <div><span class="route-row-icon" aria-hidden="true">{index + 1}</span><dt>{row.label}</dt><dd>{row.value}</dd></div>)}</dl>
      </section>
      <div class="route-guide__right">
        <ElevationProfile route={route} />
        <section class="route-practical" aria-labelledby="route-practical-title">
          <header class="route-section-header">
            <p class="route-section-eyebrow">Планирање</p>
            <h2 class="route-section-title" id="route-practical-title">Практичне информације</h2>
          </header>
          <dl>
            {practicalRows.map((row) => <div><dt>{row.label}</dt><dd><span>{row.value}</span>{row.note && <small>{row.note}</small>}</dd></div>)}
            {practical?.last_verified_at && <div><dt>Последња провјера</dt><dd><time datetime={practical.last_verified_at}>{practical.last_verified_at}</time></dd></div>}
          </dl>
        </section>
      </div>
    </div>

    {remainingNarrativeSections.map((section) => <section class="shell route-narrative"><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph.text}</p>)}</section>)}

    {route.highlights.length > 0 && <section class="shell route-highlights" aria-labelledby="route-highlights-title">
      <header class="route-section-header">
        <p class="route-section-eyebrow">Успут</p>
        <h2 class="route-section-title" id="route-highlights-title">Успут вриједи видјети</h2>
      </header>
      <ol>{route.highlights.map((highlight, index) => <li><span aria-hidden="true">{index + 1}</span><div><h3>{highlight.title}</h3><p>{highlight.description}</p></div>{highlight.distance_from_start_km !== undefined && <small>~ {highlight.distance_from_start_km.toLocaleString("sr-ME", { maximumFractionDigits: 1 })} km од полазишта</small>}</li>)}</ol>
    </section>}

    <section class="shell route-places" aria-labelledby="route-places-title">
      <header class="route-section-header"><p class="route-section-eyebrow">Повезана мјеста</p><h2 class="route-section-title" id="route-places-title">Светиње на рути</h2></header>
      <div>{[route.startPlace, ...route.waypointPlaces, route.endPlace].map((place) => <PlaceCard place={place} />)}</div>
    </section>

    <section class="shell route-cta" aria-labelledby="route-cta-title">
      <h2 id="route-cta-title">Пронађите више инспирације за ваша путовања</h2>
      <a href="/rute/">Прегледај све руте</a>
    </section>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-route-share]").forEach((button) => {
    button.addEventListener("click", async () => {
      const status = button.parentElement?.querySelector<HTMLElement>("[data-route-share-status]");
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (status) status.textContent = "Веза је копирана.";
        button.setAttribute("data-copied", "true");
      } catch {
        if (status) status.textContent = "Веза није могла бити копирана.";
      }
    });
  });
</script>
