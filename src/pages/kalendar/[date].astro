---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadCalendarDays, localizedCalendarDate, type CalendarDay } from "../../lib/calendar/content";
import { gospelReadingsForDate, loadGospelReadingsDataset, type GospelReading } from "../../lib/calendar/gospel-readings";
import { loadFeastRegistry } from "../../lib/content/feast-registry";
import { loadVisiblePlaces } from "../../lib/content/publication";
import { patronalFeastDay, selectVisibleFeastCatalogues, type PublicPatronalFeastDay } from "../../lib/public-feast-catalogues";
import CalendarGospelReadings from "../../components/CalendarGospelReadings.astro";
import PatronalFeastGroups from "../../components/PatronalFeastGroups.astro";

export async function getStaticPaths() {
  const [days, gospelDataset, registry, places] = await Promise.all([
    loadCalendarDays(),
    loadGospelReadingsDataset(),
    loadFeastRegistry(),
    loadVisiblePlaces(),
  ]);
  const catalogues = selectVisibleFeastCatalogues(places);
  return days.map((day) => ({
    params: { date: day.date },
    props: {
      day,
      days,
      gospelReadings: gospelReadingsForDate(gospelDataset, day.date),
      patronalFeasts: patronalFeastDay(registry, catalogues, day.date),
    },
  }));
}

interface Props { day: CalendarDay; days: CalendarDay[]; gospelReadings: readonly GospelReading[]; patronalFeasts: PublicPatronalFeastDay }
const { day, days, gospelReadings, patronalFeasts } = Astro.props;
const index = days.findIndex((candidate) => candidate.date === day.date);
const previous = days[index - 1];
const next = days[index + 1];
const firstDate = days[0]?.date;
const lastDate = days.at(-1)?.date;
---

<BaseLayout title={`${day.commemoration_sr} — Православни календар`} description={`Провјерени календарски подаци за ${localizedCalendarDate(day.date, { day: "numeric", month: "long", year: "numeric" })}.`} canonicalPath={`/kalendar/${day.date}/`}>
  <article class="calendar-day shell" data-calendar-day={day.date}>
    <nav class="calendar-day__nav" aria-label="Кретање кроз календар">
      {previous ? <a rel="prev" href={`/kalendar/${previous.date}/`}>← Претходни дан</a> : <span></span>}
      <a href="/kalendar/">Календар 2026</a>
      {next ? <a rel="next" href={`/kalendar/${next.date}/`}>Сљедећи дан →</a> : <span></span>}
    </nav>
    <header class="calendar-day__header">
      <p class="page-eyebrow">{day.weekday_sr}</p>
      <time datetime={day.date}>{localizedCalendarDate(day.date, { day: "numeric", month: "long", year: "numeric" })}</time>
      <p class="calendar-day__julian">По јулијанском календару: {localizedCalendarDate(day.julian_date, { day: "numeric", month: "long", year: "numeric" })}</p>
      <h1>{day.commemoration_sr}</h1>
      <p>{day.week_context_sr}</p>
      <form class="calendar-picker calendar-day__picker" action="/kalendar/" data-calendar-picker>
        <label for="calendar-day-date">Изаберите други датум</label>
        <input id="calendar-day-date" name="date" type="date" min={firstDate} max={lastDate} value={day.date} />
        <button type="submit">Отвори дан</button>
      </form>
    </header>
    <PatronalFeastGroups title="Славе овог дана" variant="selected" feasts={patronalFeasts.feasts} />
    {patronalFeasts.upcoming && <PatronalFeastGroups
      title="Предстојеће славе"
      variant="upcoming"
      date={patronalFeasts.upcoming.date}
      dateLabel={patronalFeasts.upcoming.dateLabel}
      calendarHref={patronalFeasts.upcoming.calendarHref}
      feasts={patronalFeasts.upcoming.feasts}
    />}
    <section class="calendar-day__readings" id="jevandjelje" aria-labelledby="gospel-title">
      <h2 id="gospel-title">Јеванђелска читања</h2>
      {gospelReadings.length > 0
        ? <CalendarGospelReadings readings={gospelReadings} />
        : <p class="calendar-day__empty">За овај дан литургијско јеванђелско читање није наведено.</p>}
    </section>
  </article>
</BaseLayout>

<script>
  const picker = document.querySelector<HTMLFormElement>("[data-calendar-picker]");
  picker?.addEventListener("submit", (event) => {
    event.preventDefault();
    const input = picker.querySelector<HTMLInputElement>('input[type="date"]');
    if (input?.value) window.location.href = `/kalendar/${input.value}/`;
  });
</script>
