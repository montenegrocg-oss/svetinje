---
import DedicatedMap from "../../components/DedicatedMap.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadVisiblePlaces } from "../../lib/content/publication";
import { selectPublicDiscoveryPlaces } from "../../lib/public-place-discovery";

const places = selectPublicDiscoveryPlaces(await loadVisiblePlaces());
---

<BaseLayout
  title="Мапа — Светиње"
  description="Интерактивна карта православних манастира и храмова у Црној Гори."
  canonicalPath="/mapa/"
>
  <DedicatedMap places={places} />
</BaseLayout>
