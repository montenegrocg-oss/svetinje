---
import LocalizedPublicPage from "../../components/LocalizedPublicPage.astro";
import PlaceDetailPage from "../../components/PlaceDetailPage.astro";
import { placeDetailRoot, type Locale } from "../../i18n/config";
import { localizedSlugsForPlace } from "../../lib/content/localized-publication";
import { localizedStaticPaths } from "../../lib/localized-static-paths";
export function getStaticPaths() { return localizedStaticPaths("ru"); }
const props = Astro.props as any;
const localeLinks: Partial<Record<Locale, string>> = props.page === "place" ? Object.fromEntries(Object.entries(await localizedSlugsForPlace(props.place.id)).map(([locale, slug]) => [locale, `${placeDetailRoot[locale as Locale]}${slug}/`])) : {};
---
{props.page === "place"
  ? <PlaceDetailPage place={props.place} locale="ru" relatedPlaces={props.relatedPlaces} routes={props.routes} localeLinks={localeLinks} />
  : <LocalizedPublicPage locale="ru" page={props.page} />}
