{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svetinje.me/schemas/calendar-day.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "julian_date", "title", "commemorations"],
  "properties": {
    "schema_version": { "const": 1 },
    "date": { "type": "string", "format": "date", "pattern": "^2026-" },
    "julian_date": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "commemorations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "uniqueItems": true },
    "gospel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_reading", "readings"],
      "properties": {
        "primary_reading": { "type": "integer", "minimum": 0 },
        "readings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reading" }
        }
      }
    }
  },
  "$defs": {
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "zachalo", "scope", "label", "ranges"],
      "properties": {
        "book": { "enum": ["mt", "mk", "lk", "jn"] },
        "zachalo": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["day", "sunday", "feast", "saint", "unknown"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 300 },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter", "verses"],
            "properties": {
              "chapter": { "type": "integer", "minimum": 1 },
              "verses": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?$" } }
            }
          }
        }
      }
    }
  }
}
